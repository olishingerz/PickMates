<%
  let statusLabel = null;
  let statusClass = null;
  if (g.tournament_complete)  { statusLabel = 'Complete';    statusClass = 'status-done'; }
  else if (g.is_started)      { statusLabel = 'In Progress'; statusClass = 'status-live'; }

  // Complete games show when they actually finished (not when they were
  // created); live (in-progress) games show no date at all; lobby games still
  // show the scheduled start (or creation) date so hosts can see how old it is.
  let eventDate = null;
  let eventDateRaw = null;
  if (g.tournament_complete) {
    eventDateRaw = g.completed_at || g.tournament_end_date || g.created_at;
  } else if (!g.is_started) {
    eventDateRaw = g.tournament_start_date || g.created_at;
  }
  if (eventDateRaw) {
    eventDate = new Date(eventDateRaw).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  // Prize pot — each game type stores its rate(s) per-player; the actual pot
  // is that rate times however many are (or were) in the game.
  let prizePot = 0;
  if (g.game_type === 'last_man_standing') prizePot = (g.prize_individual || 0) * g.participant_count;
  else if (g.game_type === 'golf_scorecard') prizePot = (g.scorecard_entry_fee || 0) * g.participant_count;
  else prizePot = ((g.prize_team || 0) + (g.prize_individual || 0)) * g.participant_count;

  // Progress bar — only where a clean, honest fraction is already available:
  // LMS survival rate while a round is live, or golf draft pick progress
  // while the draft itself is under way. No bar otherwise (lobby, a golf
  // tournament in progress, or a scorecard round) rather than fabricate one.
  let progressPct   = null;
  let progressLabel = null;
  if (g.game_type === 'last_man_standing' && g.is_started && !g.tournament_complete && g.entryCount > 0) {
    progressPct   = Math.round((g.aliveCount / g.entryCount) * 100);
    progressLabel = `${g.aliveCount} of ${g.entryCount} alive`;
  } else if (g.game_type === 'golf_draft' && g.is_started && !g.is_complete && typeof PICKS_PER_PLAYER !== 'undefined') {
    const totalPicks = g.participant_count * PICKS_PER_PLAYER;
    if (totalPicks > 0) {
      progressPct   = Math.round(((g.current_pick_index || 0) / totalPicks) * 100);
      progressLabel = `${g.current_pick_index || 0} of ${totalPicks} picks made`;
    }
  }

  const avatars     = g.participants || [];
  const avatarShown  = avatars.slice(0, 5);
  const avatarExtra  = avatars.length - avatarShown.length;
%>
<div class="card game-card" onclick="location.href='/game/<%= g.id %>'"
     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();location.href='/game/<%= g.id %>'}"
     tabindex="0" role="link" aria-label="Open <%= g.name %>" style="cursor:pointer">
  <div class="game-card-header">
    <div>
      <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
        <h2 class="game-card-name"><%= g.name %></h2>
        <span class="game-type-badge <%= g.game_type === 'last_man_standing' ? 'game-type-lms' : g.game_type === 'golf_scorecard' ? 'game-type-scorecard' : 'game-type-golf' %>">
          <%= g.game_type === 'last_man_standing' ? '🏆 Last Man Standing' : g.game_type === 'golf_scorecard' ? '⛳ Golf Scorecard' : '⛳ Golf Draft' %>
        </span>
      </div>
      <% if (g.game_type === 'last_man_standing') { %>
        <% const gameLeagues = (g.lms_leagues || 'eng.1').split(',').map(s => s.trim()).filter(Boolean); %>
        <p class="muted game-card-tournament">⚽ <%= gameLeagues.map(l => LEAGUE_NAMES[l] || l).join(' + ') %></p>
      <% } else if (g.game_type === 'golf_scorecard') { %>
        <p class="muted game-card-tournament">⛳ <%= g.scorecard_course_name || 'No course set' %></p>
      <% } else if (g.tournament_name) { %>
        <p class="muted game-card-tournament">⛳ <%= g.tournament_name %></p>
      <% } else { %>
        <p class="muted game-card-tournament">No tournament selected</p>
      <% } %>
    </div>
    <% if (statusLabel) { %><span class="status-badge <%= statusClass %>"><%= statusLabel %></span><% } %>
  </div>

  <div class="game-card-meta" style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
    <% if (avatarShown.length > 0) { %>
      <span class="avatar-stack">
        <% avatarShown.forEach(p => { %>
          <%- include('player-avatar', { avatar: p.avatar, username: p.username, size: 26 }) %>
        <% }) %>
        <% if (avatarExtra > 0) { %><span class="avatar-stack-more">+<%= avatarExtra %></span><% } %>
      </span>
    <% } else { %>
      <span class="muted">No players yet</span>
    <% } %>
    <% if (eventDate) { %><span class="muted">· <%= eventDate %></span><% } %>
    <% if (user && g.user_joined && g.is_started && g.user_rank) { %>
      <span style="font-size:.8rem;font-weight:700;color:var(--green-dark);background:var(--green-light);padding:.15rem .45rem;border-radius:20px">
        #<%= g.user_rank %> of <%= g.participant_count %>
      </span>
    <% } %>
  </div>

  <% if (prizePot > 0) { %>
    <div class="game-card-prize">💰 <strong>£<%= prizePot %></strong> prize pot</div>
  <% } %>

  <% if (g.pickDeadline) { %>
    <div class="game-card-fixture">
      ⏱ Your pick closes in <span class="countdown-timer" data-deadline="<%= new Date(g.pickDeadline).toISOString() %>">…</span>
    </div>
  <% } else if (g.nextDeadline) { %>
    <div class="game-card-fixture">
      ⏭ Next: <%= new Date(g.nextDeadline).toLocaleString('en-GB', { timeZone:'Europe/London', weekday:'short', day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %>
    </div>
  <% } %>

  <% if (progressPct !== null) { %>
    <div class="game-card-progress">
      <div class="progress-bar-track"><div class="progress-bar-fill" style="width:<%= progressPct %>%"></div></div>
      <span class="muted" style="font-size:.76rem"><%= progressLabel %></span>
    </div>
  <% } %>

  <div class="game-card-actions" onclick="event.stopPropagation()">
    <% if (user) { %>
      <% const isGameHost = user.isAdmin || g.host_user_id === user.id; %>
      <% if (!g.is_started) { %>
        <% if (g.game_type === 'last_man_standing') { %>
          <% if (g.user_joined) { %>
            <a href="/game/<%= g.id %>/draft" class="btn btn-sm btn-amber">Lobby</a>
          <% } else { %>
            <a href="/game/<%= g.id %>" class="btn btn-sm" style="background:var(--green);color:#fff">Join game</a>
          <% } %>
        <% } else if (g.game_type === 'golf_scorecard') { %>
          <a href="/game/<%= g.id %>/draft" class="btn btn-sm <%= g.user_joined ? 'btn-amber' : '' %>" style="<%= g.user_joined ? '' : 'background:var(--green);color:#fff' %>"><%= g.user_joined ? 'Lobby' : 'Join game' %></a>
        <% } else { %>
          <% if (g.user_joined || isGameHost) { %>
            <a href="/game/<%= g.id %>/draft" class="btn btn-sm btn-amber">Draft</a>
          <% } %>
          <% if (!g.user_joined) { %>
            <form action="/game/<%= g.id %>/join" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm" style="background:var(--green);color:#fff">Join game</button>
            </form>
          <% } %>
        <% } %>

      <% } else if (g.is_started && !g.is_complete) { %>
        <% if ((g.user_joined || isGameHost) && g.game_type !== 'golf_scorecard') { %>
          <% if (g.game_type === 'last_man_standing') { %>
            <% if (!g.userHasPicked && !g.userEliminated) { %>
              <a href="/game/<%= g.id %>/lms/picks" class="btn btn-sm btn-amber">Make pick</a>
            <% } %>
          <% } else { %>
            <a href="/game/<%= g.id %>/draft" class="btn btn-sm btn-amber">Draft</a>
          <% } %>
        <% } %>
      <% } %>
      <% if (g.user_joined) { %>
        <span class="muted" style="font-size:.82rem;align-self:center">✓ Joined</span>
      <% } %>
    <% } else { %>
      <% if (!g.is_started) { %>
        <a href="/auth/register" class="btn btn-sm" style="background:var(--green);color:#fff">Join game</a>
      <% } %>
    <% } %>
  </div>
</div>

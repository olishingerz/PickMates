<% if (impersonating) { %>
  <form action="/admin/unimpersonate" method="POST" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button type="submit" class="btn btn-sm btn-gold" style="margin-right:.5rem">
      ← Back to admin
    </button>
  </form>
<% } %>
<% if (user) { %>
  <div class="nav-dropdown" id="nav-dropdown">
    <button class="nav-dropdown-trigger" id="nav-dropdown-btn" type="button">
      <% if (user.avatar) { %>
        <img src="<%= user.avatar %>" class="nav-avatar" alt="" />
      <% } else { %>
        <span class="nav-avatar-initial"><%= user.username.charAt(0).toUpperCase() %></span>
      <% } %>
      <span class="nav-username"><%= user.username %></span>
      <span class="dropdown-caret">▾</span>
    </button>
    <div class="nav-dropdown-menu" id="nav-dropdown-menu">
      <a href="/" class="nav-dropdown-item">🏠 Games</a>
      <a href="/how-it-works" class="nav-dropdown-item">📖 How it Works</a>
      <a href="/winners-club" class="nav-dropdown-item">🏆 Winners Club</a>
      <a href="/contact" class="nav-dropdown-item">✉ Contact Us</a>
      <% if (canCreateGames) { %>
        <a href="/games/create" class="nav-dropdown-item">＋ Create Game</a>
      <% } %>
      <% if (user.isAdmin) { %>
        <a href="/admin" class="nav-dropdown-item">⚙ Admin</a>
      <% } %>
      <div class="nav-dropdown-divider"></div>
      <a href="/profile" class="nav-dropdown-item">👤 Profile</a>
      <form action="/auth/logout" method="POST" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="nav-dropdown-item nav-dropdown-btn">🚪 Log out</button>
      </form>
    </div>
  </div>
<% } else { %>
  <div class="nav-dropdown" id="nav-dropdown">
    <button class="nav-dropdown-trigger" id="nav-dropdown-btn" type="button">
      <span>☰</span> Menu
      <span class="dropdown-caret">▾</span>
    </button>
    <div class="nav-dropdown-menu" id="nav-dropdown-menu">
      <a href="/how-it-works" class="nav-dropdown-item">📖 How it Works</a>
      <a href="/games/create" class="nav-dropdown-item">＋ Create Game</a>
      <a href="/contact" class="nav-dropdown-item">✉ Contact Us</a>
      <div class="nav-dropdown-divider"></div>
      <a href="/auth/login" class="nav-dropdown-item">Log in</a>
      <a href="/auth/register" class="nav-dropdown-item">Register</a>
    </div>
  </div>
<% } %>
<script>
  (function() {
    const btn  = document.getElementById('nav-dropdown-btn');
    const menu = document.getElementById('nav-dropdown-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', e => { e.stopPropagation(); menu.classList.toggle('open'); });
    document.addEventListener('click', () => menu.classList.remove('open'));

    // Active nav item: highlight current page
    const path = location.pathname;
    document.querySelectorAll('.nav-dropdown-item[href]').forEach(function(a) {
      const href = a.getAttribute('href');
      if (href === '/' ? path === '/' : (href !== '/' && path.startsWith(href))) {
        a.classList.add('active');
      }
    });
  })();
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lobby – <%= game.name %></title>
  <link rel="icon" href="/FavIcon.png" type="image/png" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates <span class="logo-sub"><%= game.name %></span></a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <div class="page-header">
      <h1>Golf Scorecard Lobby</h1>
      <p class="last-updated">
        <% if (game.scorecard_course_name) { %>
          <strong><%= game.scorecard_course_name %></strong><% if (game.scorecard_course_par) { %> · Par <%= game.scorecard_course_par %><% } %>
        <% } %>
        <% if (game.scorecard_entry_fee > 0) { %>
          <span class="muted"> · Entry fee £<%= game.scorecard_entry_fee %> per player</span>
        <% } %>
      </p>
      <% if (game.host_username) { %>
        <p class="last-updated" style="margin-top:.2rem">👤 Hosted by <strong><%= game.host_username %></strong></p>
      <% } %>
      <% const isIndividual = game.scorecard_format === 'individual'; %>
      <p class="last-updated" style="margin-top:.2rem">
        <% if (game.is_started) { %>
          <strong style="color:var(--green-dark)">Game in progress.</strong> <%= isIndividual ? 'Handicaps are locked in.' : 'Teams and handicaps are locked in.' %>
        <% } else if (user && canManage) { %>
          <strong style="color:var(--green-dark)">Waiting to start.</strong> <%= isIndividual ? 'Get everyone joined, set handicaps, then start the game.' : 'Get everyone into a team, set handicaps, then start the game.' %>
        <% } else { %>
          Waiting for the host to start the game.
        <% } %>
      </p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <!-- ── Individual format: one flat player list, no teams ──────────────── -->
    <% if (isIndividual) { %>
      <% const meJoined = user && allParticipants.some(p => p.user_id === user.id); %>
      <div class="card" style="margin-bottom:1rem">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem">
          <h2 class="section-title" style="margin:0">Players</h2>
          <% if (!game.is_started && user && !meJoined) { %>
            <form action="/game/<%= game.id %>/scorecard/join" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm" style="background:var(--green);color:#fff">Join game</button>
            </form>
          <% } else if (meJoined) { %>
            <span class="status-badge status-live">✓ You're in</span>
          <% } %>
        </div>

        <% if (allParticipants.length === 0) { %>
          <p class="muted" style="margin-top:.6rem">No players yet.</p>
        <% } else { %>
          <div class="leaderboard-table-wrap" style="margin-top:.6rem">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Handicap</th>
                  <% if (canManage && !game.is_started) { %><th></th><% } %>
                </tr>
              </thead>
              <tbody>
                <% allParticipants.forEach(p => { %>
                  <tr>
                    <td>
                      <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <%- include('partials/player-avatar', { avatar: p.avatar, username: p.username }) %>
                        <%= p.username %>
                      </span>
                      <% if (user && p.user_id === user.id) { %> <span class="muted" style="font-size:.78rem">(you)</span><% } %>
                    </td>
                    <td>
                      <% if (canManage && !game.is_started) { %>
                        <form action="/game/<%= game.id %>/scorecard/handicap" method="POST" style="display:flex;gap:.3rem;align-items:center">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="participant_id" value="<%= p.participant_id %>" />
                          <input type="number" name="handicap" min="0" max="54" step="0.1"
                                 value="<%= p.handicap !== null ? p.handicap : '' %>" placeholder="—"
                                 style="padding:.3rem .5rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;width:70px" />
                          <button type="submit" class="btn btn-sm" style="padding:.2rem .5rem;font-size:.78rem">Save</button>
                        </form>
                      <% } else { %>
                        <%= p.handicap !== null ? p.handicap : '—' %>
                      <% } %>
                    </td>
                    <% if (canManage && !game.is_started) { %>
                      <td>
                        <form action="/game/<%= game.id %>/scorecard/remove-player" method="POST" style="display:inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="participant_id" value="<%= p.participant_id %>" />
                          <button type="submit" class="btn btn-sm btn-danger" style="padding:.15rem .45rem;font-size:.8rem"
                                  onclick="return confirm('Remove <%= p.username.replace(/'/g, "\\'") %> from this game?')">✕</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (canManage && !game.is_started) { %>
          <% if (friendsToAdd.length > 0) { %>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.7rem;padding-top:.7rem;border-top:1px solid var(--border)">
              <% friendsToAdd.forEach(f => { %>
                <form action="/game/<%= game.id %>/scorecard/add-player" method="POST" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="username" value="<%= f.username %>" />
                  <button type="submit" class="btn btn-sm btn-ghost" style="padding:.2rem .6rem;font-size:.8rem">+ <%= f.username %></button>
                </form>
              <% }) %>
            </div>
          <% } %>
          <form action="/game/<%= game.id %>/scorecard/add-player" method="POST"
                style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;margin-top:.5rem<%= friendsToAdd.length === 0 ? ';padding-top:.7rem;border-top:1px solid var(--border)' : '' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="text" name="username" list="all-usernames" placeholder="Add player by username…" maxlength="50" required
                   autocomplete="off"
                   style="padding:.35rem .6rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;min-width:200px" />
            <button type="submit" class="btn btn-sm">+ Add</button>
          </form>
          <datalist id="all-usernames">
            <% suggestedUsernames.forEach(u => { %><option value="<%= u %>"></option><% }) %>
          </datalist>
          <p class="admin-hint" style="margin-top:.5rem;margin-bottom:0">
            Adds an existing registered user by username.
          </p>
        <% } %>
      </div>
    <% } %>

    <!-- ── Teams ────────────────────────────────────────────────────────── -->
    <% if (!isIndividual) { %>
    <% teams.forEach(team => { %>
      <% const onThisTeam = user && team.players.some(p => p.user_id === user.id); %>
      <div class="card" style="margin-bottom:1rem">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem">
          <h2 class="section-title" style="margin:0"><%= team.name %></h2>
          <% if (!game.is_started && user && !onThisTeam) { %>
            <form action="/game/<%= game.id %>/scorecard/join-team" method="POST" style="display:inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="team_id" value="<%= team.id %>" />
              <button type="submit" class="btn btn-sm" style="background:var(--green);color:#fff">Join this team</button>
            </form>
          <% } else if (onThisTeam) { %>
            <span class="status-badge status-live">✓ You're on this team</span>
          <% } %>
        </div>

        <% if (team.players.length === 0) { %>
          <p class="muted" style="margin-top:.6rem">No players yet.</p>
        <% } else { %>
          <div class="leaderboard-table-wrap" style="margin-top:.6rem">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Handicap</th>
                  <% if (teeTimes.length > 0) { %><th>Tee Time</th><% } %>
                  <% if (canManage && !game.is_started) { %><th></th><% } %>
                </tr>
              </thead>
              <tbody>
                <% team.players.forEach(p => { %>
                  <tr>
                    <td>
                      <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <%- include('partials/player-avatar', { avatar: p.avatar, username: p.username }) %>
                        <%= p.username %>
                      </span>
                      <% if (user && p.user_id === user.id) { %> <span class="muted" style="font-size:.78rem">(you)</span><% } %>
                    </td>
                    <td>
                      <% if (canManage && !game.is_started) { %>
                        <form action="/game/<%= game.id %>/scorecard/handicap" method="POST" style="display:flex;gap:.3rem;align-items:center">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="participant_id" value="<%= p.participant_id %>" />
                          <input type="number" name="handicap" min="0" max="54" step="0.1"
                                 value="<%= p.handicap !== null ? p.handicap : '' %>" placeholder="—"
                                 style="padding:.3rem .5rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;width:70px" />
                          <button type="submit" class="btn btn-sm" style="padding:.2rem .5rem;font-size:.78rem">Save</button>
                        </form>
                      <% } else { %>
                        <%= p.handicap !== null ? p.handicap : '—' %>
                      <% } %>
                    </td>
                    <% if (teeTimes.length > 0) { %>
                      <td>
                        <% if (canManage) { %>
                          <form action="/game/<%= game.id %>/scorecard/tee-time" method="POST" style="display:flex;gap:.3rem;align-items:center">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="participant_id" value="<%= p.participant_id %>" />
                            <select name="tee_time_id" style="padding:.3rem .4rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.82rem">
                              <option value="">— None —</option>
                              <% teeTimes.forEach(tt => { %>
                                <option value="<%= tt.id %>" <%= p.scorecard_tee_time_id === tt.id ? 'selected' : '' %>><%= tt.label %></option>
                              <% }) %>
                            </select>
                            <button type="submit" class="btn btn-sm" style="padding:.2rem .5rem;font-size:.78rem">Save</button>
                          </form>
                        <% } else { %>
                          <%= p.tee_time_label || '—' %>
                        <% } %>
                      </td>
                    <% } %>
                    <% if (canManage && !game.is_started) { %>
                      <td>
                        <form action="/game/<%= game.id %>/scorecard/remove-player" method="POST" style="display:inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="participant_id" value="<%= p.participant_id %>" />
                          <button type="submit" class="btn btn-sm btn-danger" style="padding:.15rem .45rem;font-size:.8rem"
                                  onclick="return confirm('Remove <%= p.username.replace(/'/g, "\\'") %> from this game?')">✕</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (canManage && !game.is_started) { %>
          <% if (friendsToAdd.length > 0) { %>
            <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.7rem;padding-top:.7rem;border-top:1px solid var(--border)">
              <% friendsToAdd.forEach(f => { %>
                <form action="/game/<%= game.id %>/scorecard/add-player" method="POST" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="team_id" value="<%= team.id %>" />
                  <input type="hidden" name="username" value="<%= f.username %>" />
                  <button type="submit" class="btn btn-sm btn-ghost" style="padding:.2rem .6rem;font-size:.8rem">+ <%= f.username %></button>
                </form>
              <% }) %>
            </div>
          <% } %>
          <form action="/game/<%= game.id %>/scorecard/add-player" method="POST"
                style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;margin-top:.5rem<%= friendsToAdd.length === 0 ? ';padding-top:.7rem;border-top:1px solid var(--border)' : '' %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="team_id" value="<%= team.id %>" />
            <input type="text" name="username" list="all-usernames" placeholder="Add player by username…" maxlength="50" required
                   autocomplete="off"
                   style="padding:.35rem .6rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;min-width:200px" />
            <button type="submit" class="btn btn-sm">+ Add</button>
          </form>
        <% } %>
      </div>
    <% }) %>

    <% if (canManage && !game.is_started) { %>
      <datalist id="all-usernames">
        <% suggestedUsernames.forEach(u => { %><option value="<%= u %>"></option><% }) %>
      </datalist>
      <p class="admin-hint" style="margin-top:-.5rem;margin-bottom:1rem">
        Adds an existing registered user by username.
      </p>
    <% } %>

    <!-- ── Unassigned players (shouldn't normally happen — joining always picks a team) ── -->
    <% if (unassignedParticipants.length > 0) { %>
      <div class="card" style="margin-bottom:1rem;background:#fffbeb;border:1px solid #f59e0b">
        <h2 class="section-title">Not yet on a team</h2>
        <ul style="margin:0;padding-left:1.2rem;list-style:none">
          <% unassignedParticipants.forEach(p => { %>
            <li style="font-size:.9rem;display:flex;align-items:center;gap:.5rem;margin-bottom:.3rem">
              <%= p.username %>
              <% if (canManage && !game.is_started) { %>
                <form action="/game/<%= game.id %>/scorecard/remove-player" method="POST" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="participant_id" value="<%= p.participant_id %>" />
                  <button type="submit" class="btn btn-sm btn-danger" style="padding:.1rem .4rem;font-size:.75rem"
                          onclick="return confirm('Remove <%= p.username.replace(/'/g, "\\'") %> from this game?')">✕</button>
                </form>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    <% } %>

    <!-- ── Tee times ────────────────────────────────────────────────────── -->
    <% if (canManage && !isIndividual) { %>
      <div class="card admin-card" style="margin-bottom:1rem">
        <h2 class="section-title">Tee Times</h2>
        <p class="admin-hint">Optional — group players by who's actually playing together on the course. Anyone in a tee time can enter scores for the rest of their group, even across different teams.</p>
        <% if (teeTimes.length > 0) { %>
          <div style="display:flex;flex-direction:column;gap:.5rem;margin:.8rem 0">
            <% teeTimes.forEach(tt => { %>
              <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
                <strong style="font-size:.88rem;min-width:100px"><%= tt.label %></strong>
                <span class="muted" style="font-size:.82rem;flex:1">
                  <%= tt.players.length > 0 ? tt.players.map(p => p.username).join(', ') : 'No players yet' %>
                </span>
                <% if (tt.players.length === 0) { %>
                  <form action="/game/<%= game.id %>/scorecard/tee-times/remove" method="POST" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="tee_time_id" value="<%= tt.id %>" />
                    <button type="submit" class="btn btn-sm btn-danger" style="padding:.15rem .45rem;font-size:.78rem">✕</button>
                  </form>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <form action="/game/<%= game.id %>/scorecard/tee-times/add" method="POST" style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="text" name="label" placeholder="e.g. 09:10" maxlength="50" required
                 style="padding:.35rem .6rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;min-width:140px" />
          <button type="submit" class="btn btn-sm">+ Add tee time</button>
        </form>
      </div>
    <% } %>

    <!-- ── Invite link ──────────────────────────────────────────────────── -->
    <% if (!game.is_started && game.invite_code) { %>
      <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:.8rem;flex-wrap:wrap;padding:1rem 1.5rem">
        <div>
          <p class="label-small" style="margin-bottom:.25rem">Invite link</p>
          <span id="invite-url" style="font-size:.85rem;color:var(--green-dark);word-break:break-all"></span>
          <script>
            document.getElementById('invite-url').textContent = location.origin + '/join/<%= game.invite_code %>';
          </script>
        </div>
        <button class="btn btn-sm" onclick="
          navigator.clipboard.writeText(location.origin + '/join/<%= game.invite_code %>');
          this.textContent = '✓ Copied!';
          setTimeout(() => this.textContent = 'Copy link', 2000);
        ">Copy link</button>
      </div>
    <% } %>

    <!-- ── Closest to the pin holes ────────────────────────────────────── -->
    <% if (canManage && parThreeHoles.length > 0) { %>
      <div class="card admin-card" style="margin-bottom:1rem">
        <h2 class="section-title">Closest to the Pin holes</h2>
        <p class="admin-hint">Untick any par-3 hole you don't want a closest-to-the-pin competition on. You can change this later too.</p>
        <form action="/game/<%= game.id %>/scorecard/ctp-holes" method="POST" style="margin-top:.6rem">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="return_to" value="draft" />
          <div style="display:flex;flex-wrap:wrap;gap:.8rem;margin-bottom:.8rem">
            <% parThreeHoles.forEach(h => { %>
              <label style="display:flex;align-items:center;gap:.35rem;font-size:.85rem;cursor:pointer">
                <input type="checkbox" name="ctp_holes" value="<%= h.hole_number %>" <%= h.is_ctp ? 'checked' : '' %> />
                Hole <%= h.hole_number %>
              </label>
            <% }) %>
          </div>
          <button type="submit" class="btn btn-sm">Save</button>
        </form>
      </div>
    <% } %>

    <!-- ── Start game ───────────────────────────────────────────────────── -->
    <% if (canManage && !game.is_started) { %>
      <div class="card admin-card">
        <h2 class="section-title">Host Controls</h2>
        <p class="admin-hint"><%= isIndividual ? 'Once started, handicaps are locked in.' : 'Everyone needs to be on a team before you can start. Once started, teams and handicaps are locked in.' %></p>
        <form action="/game/<%= game.id %>/scorecard/start" method="POST" style="margin-top:.6rem"
              onsubmit="return confirm('Start the game? <%= isIndividual ? 'Handicaps will be locked in.' : 'Teams and handicaps will be locked in.' %>')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn" style="background:var(--green);color:#fff">▶ Start Game</button>
        </form>
      </div>
    <% } %>

    <% if (game.is_started) { %>
      <a href="/game/<%= game.id %>" class="btn btn-sm" style="background:#f59e0b;color:#1a1a1a">← Back to Scorecard</a>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

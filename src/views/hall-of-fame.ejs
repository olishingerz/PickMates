<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Winners Club – PickMates</title>
  <link rel="icon" href="/Logo.png" type="image/png" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates</a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <div class="page-header">
      <h1>🏆 Winners Club</h1>
      <p class="last-updated">All-time winners across every completed game.</p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <!-- ── All-time standings ─────────────────────────────────────────────── -->
    <% if (allTime.length === 0) { %>
      <div class="card empty-state">
        <p>No completed games yet — check back after the first tournament finishes.</p>
      </div>
    <% } else { %>
      <h2 class="section-title">All-time standings</h2>
      <div class="card leaderboard-table-wrap">
        <table class="hof-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Player</th>
              <th>Team wins</th>
              <th>Individual wins</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% allTime.forEach((row, i) => { %>
              <tr>
                <td class="rank">
                  <% if (i === 0) { %><span class="medal gold">1</span>
                  <% } else if (i === 1) { %><span class="medal silver">2</span>
                  <% } else if (i === 2) { %><span class="medal bronze">3</span>
                  <% } else { %><%= i + 1 %><% } %>
                </td>
                <td>
                  <span style="display:inline-flex;align-items:center;gap:.4rem">
                    <%- include('partials/player-avatar', { avatar: row.avatar, username: row.username, size: 22 }) %>
                    <strong><%= row.username %></strong>
                  </span>
                </td>
                <td><%= row.team_wins %></td>
                <td><%= row.indiv_wins %></td>
                <td><strong><%= row.total_wins %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <!-- ── Recent results ────────────────────────────────────────────────── -->
    <% if (recentWins.length > 0) { %>
      <h2 class="section-title mt-lg">All results</h2>
      <div class="winners-grid">
        <% recentWins.forEach(w => { %>
          <a href="/game/<%= w.id %>" class="winner-card">
            <div class="winner-card-tournament">
              <span class="game-type-badge <%= w.game_type === 'last_man_standing' ? 'game-type-lms' : w.game_type === 'golf_scorecard' ? 'game-type-scorecard' : 'game-type-golf' %>" style="margin-bottom:.4rem;display:inline-block">
                <%= w.game_type === 'last_man_standing' ? '🏆 Last Man Standing' : w.game_type === 'golf_scorecard' ? '⛳ Golf Scorecard' : '⛳ Golf Draft' %>
              </span>
              <div class="winner-card-name"><%= w.name %></div>
              <% if (w.tournament_name) { %><div class="muted" style="font-size:.8rem"><%= w.tournament_name %></div><% } %>
              <% if (w.event_date) { %>
                <div class="muted" style="font-size:.78rem"><%= new Date(w.event_date).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></div>
              <% } %>
            </div>
            <div class="winner-card-prizes">
              <% if (w.winner_username && w.game_type === 'golf_scorecard' && w.winning_team_members && w.winning_team_members.length > 0) { %>
                <div class="winner-entry">
                  <span class="winner-trophy">🥇</span>
                  <span class="winner-name"><%= w.winner_username %></span>
                  <span class="winner-label">· Winning team</span>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.2rem">
                  <% w.winning_team_members.forEach(m => { %>
                    <span style="display:inline-flex;align-items:center;gap:.25rem;font-size:.78rem">
                      <%- include('partials/player-avatar', { avatar: m.avatar, username: m.username, size: 18 }) %>
                      <%= m.username %>
                    </span>
                  <% }) %>
                </div>
              <% } else if (w.winner_username) { %>
                <div class="winner-entry">
                  <span class="winner-trophy">🥇</span>
                  <%- include('partials/player-avatar', { avatar: w.winner_avatar, username: w.winner_username, size: 20 }) %>
                  <span class="winner-name"><%= w.winner_username %></span>
                  <span class="winner-label"><%= w.game_type === 'last_man_standing' ? '· Last Man Standing' : w.game_type === 'golf_scorecard' ? '· Winning team' : '· Team pot' %></span>
                </div>
              <% } %>
              <% if (w.winner_individual_username && w.game_type === 'golf_draft') { %>
                <div class="winner-entry">
                  <span class="winner-trophy">🎯</span>
                  <%- include('partials/player-avatar', { avatar: w.winner_individual_avatar, username: w.winner_individual_username, size: 20 }) %>
                  <span class="winner-name"><%= w.winner_individual_username %></span>
                  <span class="winner-label">· Individual pot</span>
                </div>
              <% } %>
              <% if (w.winner_individual_username && w.game_type === 'golf_scorecard' && w.scorecard_format === 'individual') { %>
                <div class="winner-entry">
                  <span class="winner-trophy">🥇</span>
                  <%- include('partials/player-avatar', { avatar: w.winner_individual_avatar, username: w.winner_individual_username, size: 20 }) %>
                  <span class="winner-name"><%= w.winner_individual_username %></span>
                  <span class="winner-label">· Winner</span>
                </div>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>

  </main>

  <%- include('partials/footer') %>
</body>
</html>

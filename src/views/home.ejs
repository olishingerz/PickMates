<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PickMates</title>
  <link rel="icon" href="/FavIcon.png" type="image/png" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates</a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <div class="page-header">
      <h1>Games</h1>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <!-- ── Recent activity ───────────────────────────────────────────────── -->
    <% if (typeof activity !== 'undefined' && activity.length > 0) { %>
      <%
        function timeAgo(date) {
          const diffMs  = Date.now() - new Date(date).getTime();
          const diffMin = Math.floor(diffMs / 60000);
          if (diffMin < 1)  return 'just now';
          if (diffMin < 60) return `${diffMin}m ago`;
          const diffHr = Math.floor(diffMin / 60);
          if (diffHr < 24)  return `${diffHr}h ago`;
          const diffDay = Math.floor(diffHr / 24);
          if (diffDay < 7)  return `${diffDay}d ago`;
          return new Date(date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
        }
      %>
      <div class="card activity-feed" style="margin-bottom:1rem">
        <h2 class="section-title" style="margin-bottom:.4rem;font-size:.95rem">Recent Activity</h2>
        <div class="activity-list">
          <% activity.forEach(a => { %>
            <div class="activity-item">
              <span class="activity-dot"></span>
              <div>
                <p class="activity-message"><%= a.message %></p>
                <p class="activity-time"><%= timeAgo(a.created_at) %></p>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <%
      const liveGames     = games.filter(g => !g.tournament_complete);
      const completeGames = games.filter(g => g.tournament_complete);
      function accentClass(gameType) {
        if (gameType === 'last_man_standing') return 'accent-lms';
        if (gameType === 'golf_scorecard') return 'accent-scorecard';
        return 'accent-golf';
      }
    %>

    <!-- ── Live games ─────────────────────────────────────────────────────── -->
    <h2 class="section-title">Live Games <span class="muted" style="font-size:.85rem;font-weight:400">(<%= liveGames.length %>)</span></h2>
    <% if (liveGames.length === 0) { %>
      <div class="card empty-state">
        <span class="empty-state-icon">⛳</span>
        <p>No games yet.<% if (user && user.isAdmin) { %> Create the first one below.<% } %></p>
      </div>
    <% } else { %>
      <div class="games-grid">
        <% liveGames.forEach(g => { %>
          <div class="<%= accentClass(g.game_type) %>">
            <%- include('partials/game-card', { g, user, LEAGUE_NAMES, PICKS_PER_PLAYER }) %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (user && canCreateGames) { %>
      <div style="margin-top:1.5rem;text-align:center">
        <a href="/games/create" class="btn" style="font-size:.95rem;padding:.55rem 1.4rem">＋ Create New Game</a>
      </div>
    <% } %>

    <!-- ── Complete games ────────────────────────────────────────────────── -->
    <% if (completeGames.length > 0) { %>
      <h2 class="section-title mt-lg">Complete Games <span class="muted" style="font-size:.85rem;font-weight:400">(<%= completeGames.length %>)</span></h2>
      <div class="games-grid">
        <% completeGames.forEach(g => { %>
          <div class="<%= accentClass(g.game_type) %>">
            <%- include('partials/game-card', { g, user, LEAGUE_NAMES, PICKS_PER_PLAYER }) %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- ── Winners Club ──────────────────────────────────────────────── -->
    <div style="margin-top:2.5rem">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
        <h2 class="section-title" style="margin-bottom:0">🏆 Winners Club</h2>
        <% if (winners.length > 0) { %><a href="/winners-club" style="font-size:.82rem">See all →</a><% } %>
      </div>
      <% if (winners.length === 0) { %>
        <div class="card empty-state"><p>No winners yet — complete a tournament to see them here.</p></div>
      <% } else { %>
        <div class="winners-grid">
          <% winners.forEach(w => { %>
            <a href="/game/<%= w.id %>" class="winner-card">
              <div class="winner-card-tournament">
                <span class="game-type-badge <%= w.game_type === 'last_man_standing' ? 'game-type-lms' : w.game_type === 'golf_scorecard' ? 'game-type-scorecard' : 'game-type-golf' %>" style="margin-bottom:.4rem;display:inline-block">
                  <%= w.game_type === 'last_man_standing' ? '🏆 Last Man Standing' : w.game_type === 'golf_scorecard' ? '⛳ Golf Scorecard' : '⛳ Golf Draft' %>
                </span>
                <div class="winner-card-name"><%= w.name %></div>
                <% if (w.tournament_name) { %><div class="muted" style="font-size:.8rem"><%= w.tournament_name %></div><% } %>
                <% if (w.event_date) { %><div class="muted" style="font-size:.76rem"><%= new Date(w.event_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></div><% } %>
              </div>
              <div class="winner-card-prizes">
                <% if (w.winner_username) { %>
                  <div class="winner-entry">
                    <span class="winner-trophy">🥇</span>
                    <%- include('partials/player-avatar', { avatar: w.winner_avatar, username: w.winner_username, size: 20 }) %>
                    <span class="winner-name"><%= w.winner_username %></span>
                    <span class="winner-label"><%= w.game_type === 'last_man_standing' ? '· Last Man Standing' : w.game_type === 'golf_scorecard' ? '· Winning team' : '· Team pot' %></span>
                  </div>
                <% } %>
                <% if (w.winner_individual_username && w.game_type === 'golf_draft') { %>
                  <div class="winner-entry">
                    <span class="winner-trophy">🎯</span>
                    <%- include('partials/player-avatar', { avatar: w.winner_individual_avatar, username: w.winner_individual_username, size: 20 }) %>
                    <span class="winner-name"><%= w.winner_individual_username %></span>
                    <span class="winner-label">· Individual pot</span>
                  </div>
                <% } %>
                <% if (w.winner_individual_username && w.game_type === 'golf_scorecard' && w.scorecard_format === 'individual') { %>
                  <div class="winner-entry">
                    <span class="winner-trophy">🥇</span>
                    <%- include('partials/player-avatar', { avatar: w.winner_individual_avatar, username: w.winner_individual_username, size: 20 }) %>
                    <span class="winner-name"><%= w.winner_individual_username %></span>
                    <span class="winner-label">· Winner</span>
                  </div>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>

  </main>

  <script>
    (function() {
      const timers = document.querySelectorAll('.countdown-timer[data-deadline]');
      if (timers.length === 0) return;
      function fmt(ms) {
        if (ms <= 0) return 'Deadline passed';
        const s = Math.floor(ms / 1000);
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        if (d > 0) return d + 'd ' + h + 'h left';
        if (h > 0) return h + 'h ' + m + 'm left';
        if (m > 0) return m + 'm ' + sec + 's left';
        return sec + 's left!';
      }
      function tick() {
        timers.forEach(function(el) {
          const ms = new Date(el.dataset.deadline).getTime() - Date.now();
          el.textContent = fmt(ms);
          el.classList.toggle('countdown-urgent', ms > 0 && ms < 3 * 60 * 60 * 1000);
          el.classList.toggle('countdown-critical', ms > 0 && ms < 10 * 60 * 1000);
        });
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <%- include('partials/footer') %>
  <% if (showEmailPrompt) { %><%- include('partials/email-prompt-modal') %><% } %>
</body>
</html>

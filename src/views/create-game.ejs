<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Game – PickMates</title>
  <link rel="icon" href="/FavIcon.png" type="image/png" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates</a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <div class="page-header">
      <h1>Create a New Game</h1>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <form action="/games/create" method="POST" id="create-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <!-- ── Step 1: Basic details ───────────────────────────────────── -->
      <div class="card" style="margin-bottom:1rem">
        <h2 class="section-title">Game Details</h2>
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:flex-end">
          <div>
            <label class="form-label">Game type</label>
            <select name="game_type" id="game-type"
                    style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;background:#fff;display:block;margin-top:.3rem">
              <option value="golf_draft">⛳ Golf Draft</option>
              <option value="last_man_standing">🏆 Last Man Standing</option>
              <option value="golf_scorecard">⛳ Golf Scorecard</option>
            </select>
          </div>
          <div>
            <label class="form-label">Game name</label>
            <input type="text" name="name" placeholder="Enter a name for your game" required maxlength="200"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;min-width:260px;display:block;margin-top:.3rem" />
          </div>
        </div>
        <p style="margin-top:.8rem;font-size:.85rem;line-height:1.5">
          <span id="game-type-description" class="muted"></span>
          <a id="game-type-more-link" href="/how-it-works" target="_blank" style="white-space:nowrap">Full rules →</a>
        </p>

        <div style="margin-top:1rem">
          <label class="form-label" style="display:block;margin-bottom:.5rem">Who can join</label>
          <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer;margin-bottom:.4rem">
            <input type="radio" name="is_public" value="1" checked /> Public — shows in everyone's game list, anyone can join themselves
          </label>
          <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer">
            <input type="radio" name="is_public" value="0" /> Private — only visible via invite link, or players you add yourself
          </label>
        </div>
      </div>

      <!-- ── Golf Draft options ─────────────────────────────────────── -->
      <div id="golf-section" class="card" style="margin-bottom:1rem">
        <h2 class="section-title">Golf Draft Settings</h2>

        <!-- Prize amounts -->
        <div style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:flex-end;margin-bottom:1rem">
          <div>
            <label class="form-label">Team prize (£ per player)</label>
            <input type="number" name="prize_team" id="prize-team" min="0" value="10"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:130px;display:block;margin-top:.3rem" />
          </div>
          <div>
            <label class="form-label">Individual prize (£ per player)</label>
            <input type="number" name="prize_individual" id="prize-individual" min="0" value="2"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:130px;display:block;margin-top:.3rem" />
          </div>
          <div style="padding-bottom:.5rem">
            <span class="form-label">Entry fee per player</span>
            <div style="font-size:1.2rem;font-weight:700;color:var(--green);margin-top:.4rem" id="entry-total">£12</div>
          </div>
        </div>

        <!-- Tournament selection -->
        <h3 style="font-size:.9rem;font-weight:700;margin-bottom:.6rem">Select Tournament</h3>
        <input type="hidden" name="tournament_id"         id="t-id"    value="" />
        <input type="hidden" name="tournament_name"       id="t-name"  value="" />
        <input type="hidden" name="tournament_start_date" id="t-start" value="" />
        <input type="hidden" name="tournament_end_date"   id="t-end"   value="" />

        <% if (tournaments.length === 0) { %>
          <p class="muted">Could not load tournament list from ESPN. You can select a tournament later from the draft room.</p>
        <% } else { %>
          <div class="tournament-list" id="tournament-list">
            <% tournaments.forEach(t => { %>
              <%
                const start = t.startDate ? new Date(t.startDate) : null;
                const end   = t.endDate   ? new Date(t.endDate)   : null;
                const fmt   = d => d ? d.toLocaleDateString('en-GB', { day:'numeric', month:'short' }) : '';
              %>
              <div class="tournament-row" data-id="<%= t.id %>" data-name="<%= t.name %>"
                   data-start="<%= t.startDate || '' %>" data-end="<%= t.endDate || '' %>">
                <div class="tournament-row-info">
                  <span class="tournament-row-name"><%= t.name %></span>
                  <% if (start) { %>
                    <span class="muted" style="font-size:.8rem"><%= fmt(start) %><% if (end) { %> – <%= fmt(end) %><% } %></span>
                  <% } %>
                </div>
                <span class="tournament-row-check" style="display:none">✓</span>
              </div>
            <% }) %>
          </div>
          <p class="admin-hint" style="margin-top:.5rem">You can also change the tournament later from the draft room.</p>
        <% } %>
      </div>

      <!-- ── LMS options ────────────────────────────────────────────── -->
      <div id="lms-section" class="card" style="margin-bottom:1rem;display:none">
        <h2 class="section-title">Last Man Standing Settings</h2>
        <div style="display:flex;gap:1.5rem;flex-wrap:wrap">
          <div>
            <label class="form-label">Entry fee (£ per player)</label>
            <input type="number" name="lms_entry_fee" min="0" value="0"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:130px;display:block;margin-top:.3rem" />
          </div>
          <div>
            <label class="form-label" style="display:block;margin-bottom:.5rem">Leagues</label>
            <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer;margin-bottom:.4rem">
              <input type="checkbox" name="lms_leagues" value="eng.1" checked /> Premier League
            </label>
            <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer">
              <input type="checkbox" name="lms_leagues" value="eng.2" /> Championship
            </label>
          </div>
        </div>
        <div style="margin-top:1rem">
          <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer">
            <input type="checkbox" name="lms_host_plays" value="1" checked /> I want to play too, not just host
          </label>
          <p class="admin-hint" style="margin-top:.3rem">Uncheck this if you're only setting the game up for others — you can still join later if you change your mind.</p>
        </div>
      </div>

      <!-- ── Golf Scorecard options ─────────────────────────────────── -->
      <div id="scorecard-section" class="card" style="margin-bottom:1rem;display:none">
        <h2 class="section-title">Golf Scorecard Settings</h2>

        <% if (savedCourses.length > 0) { %>
          <div style="margin-bottom:1rem">
            <label class="form-label">Course</label>
            <select id="saved-course-select"
                    style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;background:#fff;display:block;margin-top:.3rem;min-width:220px">
              <option value="">— New course —</option>
              <% savedCourses.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %> (Par <%= c.par %>)</option>
              <% }) %>
            </select>
            <div style="margin-top:.5rem;display:flex;flex-direction:column;gap:.25rem">
              <% savedCourses.forEach(c => { %>
                <div style="display:flex;align-items:center;gap:.4rem;font-size:.78rem" class="muted">
                  <span><%= c.name %></span>
                  <button type="submit" form="delete-course-<%= c.id %>" class="btn btn-sm btn-danger" style="padding:.05rem .35rem;font-size:.72rem">✕</button>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <div style="display:flex;gap:.8rem;flex-wrap:wrap;align-items:flex-end;margin-bottom:1rem">
          <div>
            <label class="form-label">Course name</label>
            <input type="text" name="course_name" id="course-name" maxlength="200" placeholder="e.g. St Andrews"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;min-width:220px;display:block;margin-top:.3rem" />
          </div>
          <div>
            <label class="form-label">Course par</label>
            <input type="number" name="course_par" id="course-par" min="60" max="80" value="72"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:110px;display:block;margin-top:.3rem" />
          </div>
          <div>
            <label class="form-label">Entry fee (£ per player)</label>
            <input type="number" name="scorecard_entry_fee" min="0" value="0"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:130px;display:block;margin-top:.3rem" />
          </div>
        </div>

        <div style="margin-bottom:1.2rem">
          <label class="form-label" style="display:block;margin-bottom:.5rem">Format</label>
          <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer;margin-bottom:.4rem">
            <input type="radio" name="scorecard_format" id="format-team" value="team" checked /> Team — players are grouped into teams, with optional tee times
          </label>
          <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer">
            <input type="radio" name="scorecard_format" id="format-individual" value="individual" /> Individual — just each player's own score, no teams or tee times
          </label>
        </div>

        <h3 style="font-size:.9rem;font-weight:700;margin-bottom:.6rem">Holes</h3>
        <div style="overflow-x:auto;margin-bottom:1rem">
          <table style="border-collapse:collapse;font-size:.85rem">
            <thead>
              <tr>
                <th style="text-align:left;padding:.3rem .6rem">Hole</th>
                <th style="text-align:left;padding:.3rem .6rem">Par</th>
                <th style="text-align:left;padding:.3rem .6rem">Stroke Index</th>
              </tr>
            </thead>
            <tbody>
              <% for (let h = 1; h <= 18; h++) { %>
                <tr>
                  <td style="padding:.2rem .6rem;font-weight:600"><%= h %></td>
                  <td style="padding:.2rem .6rem">
                    <input type="number" name="hole_par_<%= h %>" id="hole-par-<%= h %>" min="3" max="6" value="4" required
                           style="padding:.3rem .5rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;width:70px" />
                  </td>
                  <td style="padding:.2rem .6rem">
                    <input type="number" name="hole_si_<%= h %>" id="hole-si-<%= h %>" min="1" max="18" value="<%= h %>" required
                           style="padding:.3rem .5rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem;width:70px" />
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <p class="admin-hint" style="margin-bottom:1rem">Stroke Index should be a unique number 1–18 across the round (1 = hardest hole).</p>

        <label style="display:flex;align-items:center;gap:.4rem;font-size:.9rem;cursor:pointer;margin-bottom:1.2rem">
          <input type="checkbox" name="save_course" id="save-course" value="1" checked />
          💾 Save this course to my library for next time
        </label>

        <div id="teams-subsection">
          <h3 style="font-size:.9rem;font-weight:700;margin-bottom:.6rem">Teams</h3>
          <div style="margin-bottom:.6rem">
            <label class="form-label">Number of teams</label>
            <input type="number" name="num_teams" id="num-teams" min="2" max="10" value="2"
                   style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:110px;display:block;margin-top:.3rem" />
          </div>
          <div id="team-names"></div>
        </div>
      </div>

      <button type="submit" class="btn" style="font-size:1rem;padding:.6rem 1.5rem">Create game →</button>
    </form>

    <!-- Each saved course's delete action is its own form, kept outside #create-form
         (nested <form> elements are invalid HTML and silently break the outer form —
         the browser closes #create-form early at the first nested </form> it hits).
         The delete button above references this one by id via the "form" attribute. -->
    <% savedCourses.forEach(c => { %>
      <form id="delete-course-<%= c.id %>" action="/games/create/delete-course" method="POST" style="display:none"
            onsubmit="return confirm('Remove \'<%= c.name.replace(/'/g, "\\'") %>\' from your saved courses?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="course_id" value="<%= c.id %>" />
      </form>
    <% }) %>
  </main>

  <%- include('partials/footer') %>

  <script>
    // Game type toggle
    const gameType        = document.getElementById('game-type');
    const golfSection      = document.getElementById('golf-section');
    const lmsSection        = document.getElementById('lms-section');
    const scorecardSection = document.getElementById('scorecard-section');
    const typeDescription   = document.getElementById('game-type-description');
    const typeMoreLink      = document.getElementById('game-type-more-link');

    const GAME_TYPE_DESCRIPTIONS = {
      golf_draft: 'Draft real PGA Tour golfers with your friends in a snake draft, then follow live tournament scores. Your team’s combined score wins the team pot; the single best individual golfer wins a separate pot.',
      last_man_standing: 'Pick one football team to win each gameweek — you can never pick the same team twice. Lose or draw and you’re out; last player standing takes the pot.',
      golf_scorecard: 'Score a real round you’re all playing together, hole by hole, using net Stableford. Compete as teams or as individuals — most points wins.',
    };
    const GAME_TYPE_ANCHORS = {
      golf_draft: '#golf-draft',
      last_man_standing: '#last-man-standing',
      golf_scorecard: '#golf-scorecard',
    };

    function updateType() {
      golfSection.style.display      = gameType.value === 'golf_draft'      ? '' : 'none';
      lmsSection.style.display       = gameType.value === 'last_man_standing' ? '' : 'none';
      scorecardSection.style.display = gameType.value === 'golf_scorecard'  ? '' : 'none';
      typeDescription.textContent = GAME_TYPE_DESCRIPTIONS[gameType.value] || '';
      typeMoreLink.href = '/how-it-works' + (GAME_TYPE_ANCHORS[gameType.value] || '');
    }
    gameType.addEventListener('change', updateType);
    updateType();

    // Golf Scorecard: prefill course fields from a saved course
    const SAVED_COURSES = <%- JSON.stringify(savedCourses) %>;
    const savedCourseSelect = document.getElementById('saved-course-select');
    const saveCourseCheckbox = document.getElementById('save-course');
    if (savedCourseSelect) {
      savedCourseSelect.addEventListener('change', () => {
        const course = SAVED_COURSES.find(c => String(c.id) === savedCourseSelect.value);
        if (!course) return;
        document.getElementById('course-name').value = course.name;
        document.getElementById('course-par').value = course.par;
        course.holes.forEach(h => {
          const parInput = document.getElementById('hole-par-' + h.hole_number);
          const siInput  = document.getElementById('hole-si-' + h.hole_number);
          if (parInput) parInput.value = h.par;
          if (siInput)  siInput.value = h.stroke_index;
        });
        // Already saved — don't save a duplicate copy by default
        if (saveCourseCheckbox) saveCourseCheckbox.checked = false;
      });
    }

    // Golf Scorecard: team vs individual format toggle
    const teamsSubsection  = document.getElementById('teams-subsection');
    const formatRadios     = document.querySelectorAll('input[name="scorecard_format"]');
    function updateFormat() {
      const isIndividual = document.getElementById('format-individual').checked;
      teamsSubsection.style.display = isIndividual ? 'none' : '';
    }
    formatRadios.forEach(r => r.addEventListener('change', updateFormat));
    updateFormat();

    // Golf Scorecard: team name fields, regenerated as the team count changes
    const numTeamsInput = document.getElementById('num-teams');
    const teamNamesDiv  = document.getElementById('team-names');

    function updateTeamNames() {
      const count = Math.min(10, Math.max(2, parseInt(numTeamsInput.value) || 2));
      const existing = Array.from(teamNamesDiv.querySelectorAll('input')).map(i => i.value);
      teamNamesDiv.innerHTML = '';
      for (let i = 1; i <= count; i++) {
        const wrap = document.createElement('div');
        wrap.style.marginBottom = '.5rem';
        const label = document.createElement('label');
        label.className = 'form-label';
        label.textContent = `Team ${i} name`;
        const input = document.createElement('input');
        input.type = 'text';
        input.name = `team_name_${i}`;
        input.maxLength = 50;
        input.required = true;
        input.value = existing[i - 1] || `Team ${i}`;
        input.style = 'padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;min-width:220px;display:block;margin-top:.3rem';
        wrap.appendChild(label);
        wrap.appendChild(input);
        teamNamesDiv.appendChild(wrap);
      }
    }
    numTeamsInput.addEventListener('input', updateTeamNames);
    updateTeamNames();

    // Entry fee total
    const prizeTeam  = document.getElementById('prize-team');
    const prizeIndiv = document.getElementById('prize-individual');
    const totalEl    = document.getElementById('entry-total');
    function updateTotal() {
      const t = parseInt(prizeTeam.value)  || 0;
      const i = parseInt(prizeIndiv.value) || 0;
      totalEl.textContent = '£' + (t + i);
    }
    prizeTeam.addEventListener('input', updateTotal);
    prizeIndiv.addEventListener('input', updateTotal);
    updateTotal();

    // Tournament selection
    const tId    = document.getElementById('t-id');
    const tName  = document.getElementById('t-name');
    const tStart = document.getElementById('t-start');
    const tEnd   = document.getElementById('t-end');

    document.querySelectorAll('.tournament-row').forEach(row => {
      row.addEventListener('click', () => {
        document.querySelectorAll('.tournament-row').forEach(r => {
          r.classList.remove('selected');
          r.querySelector('.tournament-row-check').style.display = 'none';
        });
        row.classList.add('selected');
        row.querySelector('.tournament-row-check').style.display = '';
        tId.value    = row.dataset.id;
        tName.value  = row.dataset.name;
        tStart.value = row.dataset.start;
        tEnd.value   = row.dataset.end;
      });
    });

    // If a required/invalid field is blocking submission, make that obvious instead
    // of silently doing nothing — scroll to it and highlight it. Hooked on the
    // button's click (not the form's submit) because the browser never fires
    // "submit" at all when native validation blocks it — it fires "invalid" on
    // the offending fields instead, so a submit-event listener never runs.
    const createForm = document.getElementById('create-form');
    const createBtn  = createForm.querySelector('button[type="submit"]');
    createBtn.addEventListener('click', (e) => {
      if (!createForm.checkValidity()) {
        e.preventDefault();
        createForm.reportValidity();
        const firstInvalid = createForm.querySelector(':invalid');
        if (firstInvalid) {
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalid.style.outline = '2px solid #ef4444';
          firstInvalid.focus();
        }
      }
    });
  </script>
</body>
</html>

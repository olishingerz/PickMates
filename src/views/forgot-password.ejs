<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot password – PickMates</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo">
        <img src="/Logo.png" alt="PickMates" class="logo-img" />
        PickMates
      </a>
      <nav>
        <a href="/auth/login" class="btn btn-sm btn-ghost">Log in</a>
      </nav>
    </div>
  </header>

  <main>
    <div class="auth-container">
      <div class="card auth-card">
        <h1>Forgot password</h1>
        <p class="muted" style="margin-bottom:1rem">Enter the email address on your account and we'll send you a link to reset your password.</p>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (!success) { %>
          <form action="/auth/forgot-password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="form-group">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" required autofocus autocomplete="email" />
            </div>
            <button type="submit" class="btn btn-block">Send reset link</button>
          </form>
        <% } %>

        <p class="auth-link">Remembered your password? <a href="/auth/login">Log in</a></p>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

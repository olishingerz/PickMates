<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin · PickMates</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><span class="logo-flag">⛳</span> PickMates</a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <div class="page-header">
      <h1>Admin</h1>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" style="font-family:monospace"><%= success %></div><% } %>

    <!-- ── Site settings ──────────────────────────────────────────────────── -->
    <div class="card" style="margin-bottom:2rem">
      <h2 class="section-title">Who can create games?</h2>
      <form action="/admin/settings/game-creation" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:.8rem">
          <% ROLE_OPTIONS.forEach(opt => { %>
            <label style="display:flex;align-items:center;gap:.5rem;font-size:.9rem;cursor:pointer">
              <input type="checkbox" name="roles" value="<%= opt.value %>"
                     <%= gameCreationRoles.includes(opt.value) ? 'checked' : '' %> />
              <%= opt.label %>
            </label>
          <% }) %>
        </div>
        <button type="submit" class="btn btn-sm">Save</button>
      </form>
    </div>

    <!-- ── Games ──────────────────────────────────────────────────────────── -->
    <h2 class="section-title">Games <span class="muted" style="font-size:.85rem;font-weight:400">(<%= games.length %>)</span></h2>
    <div class="leaderboard-table-wrap" style="margin-bottom:2rem">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Type</th>
            <th>Players</th>
            <th>Status</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody>
          <% games.forEach(g => {
               const status = g.tournament_complete ? 'Complete'
                            : g.is_started         ? 'In Progress'
                            : 'Waiting';
               const statusColour = g.tournament_complete ? 'var(--green)' : g.is_started ? '#f59e0b' : 'var(--muted)';
               const typLabel = g.game_type === 'last_man_standing' ? 'LMS' : g.game_type === 'golf_scorecard' ? 'Scorecard' : 'Golf';
          %>
            <tr>
              <td class="muted" style="font-size:.82rem"><%= g.id %></td>
              <td><a href="/game/<%= g.id %>" style="font-weight:600"><%= g.name %></a>
                <% if (g.game_type === 'golf_draft') { %>
                  <a href="/admin/espn-debug/<%= g.id %>" target="_blank" style="font-size:.72rem;margin-left:.4rem">ESPN debug</a>
                <% } %>
                <% if (g.tournament_name) { %><br/><span class="muted" style="font-size:.78rem"><%= g.tournament_name %></span><% } %>
              </td>
              <td class="muted" style="font-size:.82rem"><%= typLabel %></td>
              <td class="muted" style="text-align:center"><%= g.participant_count %></td>
              <td><span style="font-size:.78rem;font-weight:600;color:<%= statusColour %>"><%= status %></span></td>
              <td class="muted" style="font-size:.82rem;white-space:nowrap">
                <%= new Date(g.created_at).toLocaleDateString('en-GB', { timeZone:'Europe/London', day:'numeric', month:'short', year:'numeric' }) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ── Users ──────────────────────────────────────────────────────────── -->
    <h2 class="section-title">Users <span class="muted" style="font-size:.85rem;font-weight:400">(<%= users.length %>)</span></h2>
    <div class="leaderboard-table-wrap" style="margin-bottom:2rem">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Games</th>
            <th>Joined</th>
            <th>Last Seen</th>
            <th>Paid</th>
            <th>Admin</th>
            <th>Email</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr style="<%= u.is_banned ? 'opacity:.5' : '' %>">
              <td><strong><%= u.username %></strong><% if (u.is_banned) { %> <span style="font-size:.72rem;color:#ef4444">BANNED</span><% } %></td>
              <td class="muted" style="text-align:center"><%= u.game_count %></td>
              <td class="muted" style="font-size:.82rem;white-space:nowrap">
                <%= new Date(u.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %>
              </td>
              <td class="muted" style="font-size:.82rem;white-space:nowrap">
                <% if (u.last_seen) { %>
                  <%= new Date(u.last_seen).toLocaleDateString('en-GB', { timeZone:'Europe/London', day:'numeric', month:'short', year:'numeric' }) %>
                  <span style="color:var(--muted)"><%= new Date(u.last_seen).toLocaleTimeString('en-GB', { timeZone:'Europe/London', hour:'2-digit', minute:'2-digit' }) %></span>
                <% } else { %>
                  <span class="muted">Never</span>
                <% } %>
              </td>
              <td style="text-align:center">
                <form action="/admin/toggle-paid" method="POST" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="user_id" value="<%= u.id %>" />
                  <button type="submit" class="btn btn-sm" style="padding:.25rem .6rem;font-size:.78rem;<%= u.is_paid ? 'background:var(--green);color:#fff' : 'background:var(--card-border);color:var(--text)' %>">
                    <%= u.is_paid ? 'Paid' : 'Free' %>
                  </button>
                </form>
              </td>
              <td style="text-align:center">
                <% if (u.id !== user.id) { %>
                  <form action="/admin/toggle-admin" method="POST" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                    <button type="submit" class="btn btn-sm" style="padding:.25rem .6rem;font-size:.78rem;<%= u.is_admin ? 'background:#6366f1;color:#fff' : 'background:var(--card-border);color:var(--text)' %>">
                      <%= u.is_admin ? 'Admin' : 'User' %>
                    </button>
                  </form>
                <% } else { %>
                  <span class="muted" style="font-size:.82rem">You</span>
                <% } %>
              </td>
              <td class="muted" style="font-size:.82rem"><%= u.email || '—' %></td>
              <td style="white-space:nowrap">
                <% if (u.id !== user.id) { %>
                  <!-- Impersonate -->
                  <form action="/admin/impersonate" method="POST" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                    <button type="submit" class="btn btn-sm" title="Log in as this user" style="padding:.25rem .6rem;font-size:.78rem;background:#0ea5e9;color:#fff">👤</button>
                  </form>
                  <!-- Reset password -->
                  <form action="/admin/reset-password" method="POST" style="display:inline"
                        onsubmit="return confirm('Reset password for <%= u.username %>? A temp password will be shown.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                    <button type="submit" class="btn btn-sm" title="Reset password" style="padding:.25rem .6rem;font-size:.78rem;background:#f59e0b;color:#000">🔑</button>
                  </form>
                  <!-- Ban/unban -->
                  <form action="/admin/toggle-ban" method="POST" style="display:inline"
                        onsubmit="return confirm('<%= u.is_banned ? 'Unsuspend' : 'Suspend' %> <%= u.username %>?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                    <button type="submit" class="btn btn-sm" title="<%= u.is_banned ? 'Unsuspend' : 'Suspend' %>" style="padding:.25rem .6rem;font-size:.78rem;<%= u.is_banned ? 'background:var(--green);color:#fff' : 'background:#f97316;color:#fff' %>">
                      <%= u.is_banned ? '✓' : '🚫' %>
                    </button>
                  </form>
                  <!-- Delete -->
                  <form action="/admin/delete-user" method="POST" style="display:inline"
                        onsubmit="return confirm('Delete <%= u.username %>? This cannot be undone.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="user_id" value="<%= u.id %>" />
                    <button type="submit" class="btn btn-sm" title="Delete" style="padding:.25rem .6rem;font-size:.78rem;background:#ef4444;color:#fff">🗑</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- ── Tools ──────────────────────────────────────────────────────────── -->
    <h2 class="section-title">Tools</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1rem;margin-bottom:2rem">

      <!-- Force-set team name -->
      <div class="card">
        <h3 class="section-title" style="font-size:.95rem">Set Team Name</h3>
        <p class="muted" style="font-size:.82rem;margin-bottom:.8rem">Override or clear a player's team name in a game.</p>
        <form action="/admin/set-team-name" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-group">
            <label>Game ID</label>
            <input type="number" name="game_id" required placeholder="e.g. 4" />
          </div>
          <div class="form-group">
            <label>Username</label>
            <input type="text" name="username" required placeholder="e.g. olishingerz" />
          </div>
          <div class="form-group">
            <label>Team name <span class="muted">(leave blank to clear)</span></label>
            <input type="text" name="team_name" placeholder="e.g. The Eagles" maxlength="25" />
          </div>
          <button type="submit" class="btn btn-sm">Save</button>
        </form>
      </div>

      <!-- Rename player pick -->
      <div class="card">
        <h3 class="section-title" style="font-size:.95rem">Rename Player Pick</h3>
        <p class="muted" style="font-size:.82rem;margin-bottom:.8rem">Fix ESPN name mismatches (e.g. "Samuel Stevens" → "Sam Stevens").</p>
        <form action="/admin/rename-pick" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-group">
            <label>Game ID</label>
            <input type="number" name="game_id" required placeholder="e.g. 4" />
          </div>
          <div class="form-group">
            <label>Current name in picks</label>
            <input type="text" name="old_name" required placeholder="e.g. Samuel Stevens" />
          </div>
          <div class="form-group">
            <label>New name (ESPN name)</label>
            <input type="text" name="new_name" required placeholder="e.g. Sam Stevens" />
          </div>
          <button type="submit" class="btn btn-sm">Rename</button>
        </form>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

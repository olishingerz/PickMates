<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= game.name %> – PickMates</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates <span class="logo-sub"><%= game.name %></span></a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <%
      const alreadyJoined  = user && standings.some(s => s.user_id === user.id);
      const myStanding     = standings.find(s => user && s.user_id === user.id);
      const canPick        = game.is_started && alreadyJoined && myStanding && !myStanding.eliminated
                             && !myStanding.myCurrentPick
                             && !weekObj?.results_locked;

      // Picks are hidden until every alive player has submitted for the current week
      const aliveStandings   = standings.filter(s => !s.eliminated);
      const pickedCount      = aliveStandings.filter(s => s.myCurrentPick || s.picks.some(p => p.week_number === currentWeek)).length;
      const allPickedIn      = aliveStandings.length > 0 && pickedCount >= aliveStandings.length;
    %>
    <div class="page-header">
      <h1><%= game.name %></h1>
      <p class="muted" style="margin-top:.2rem">
        🏆 Last Man Standing
        <% leagues.forEach(l => { %>
          <span class="game-type-badge game-type-lms" style="margin-left:.3rem"><%= LEAGUE_NAMES[l] || l %></span>
        <% }) %>
      </p>
      <%
        const alive = standings.filter(s => !s.eliminated).length;
        const total = standings.length;
      %>
      <p class="muted" style="margin-top:.3rem"><strong><%= alive %></strong> of <strong><%= total %></strong> still alive — Week <strong><%= currentWeek %></strong></p>
      <% if (game.host_username) { %>
        <p class="muted" style="margin-top:.2rem;font-size:.85rem">👤 Hosted by <strong><%= game.host_username %></strong></p>
      <% } %>
      <% if (game.prize_individual > 0) { %>
        <p class="muted" style="margin-top:.2rem;font-size:.85rem">Prize pot: <strong>£<%= game.prize_individual * total %></strong> <span class="muted" style="font-size:.78rem">(£<%= game.prize_individual %> × <%= total %> player<%= total !== 1 ? 's' : '' %>)</span></p>
      <% } %>
      <% if (game.lms_continuous) { %>
        <p class="muted" style="margin-top:.2rem;font-size:.78rem">🔁 Auto-restarts a new round when this one ends</p>
      <% } %>
    <% if (game.is_started && !weekObj?.results_locked) { %>
      <p class="muted" style="margin-top:.2rem;font-size:.85rem">
        <% if (allPickedIn) { %>
          <span style="color:var(--green-dark);font-weight:600">✓ All picks in — picks revealed below</span>
        <% } else { %>
          <span><strong><%= pickedCount %></strong> of <strong><%= aliveStandings.length %></strong> picks submitted — picks hidden until everyone is in</span>
        <% } %>
      </p>
    <% } %>

      <% if (weekObj?.deadline) { %>
        <p class="last-updated">
          Week <%= currentWeek %> deadline: <%= new Date(weekObj.deadline).toLocaleString('en-GB', { timeZone:'Europe/London', day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %>
          <% if (weekObj.results_locked) { %><span class="status-badge status-done" style="margin-left:.5rem">Results locked</span><% } %>
        </p>
      <% } %>
      <div style="margin-top:.6rem;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
        <% if (alreadyJoined || canManage) { %>
          <a href="/game/<%= game.id %>/draft" class="btn btn-sm" style="background:#f59e0b;color:#1a1a1a">Lobby</a>
        <% } %>
        <% if (game.invite_code && !game.is_started && !game.tournament_complete) { %>
          <button class="btn btn-sm btn-ghost" style="color:var(--green-dark);border-color:var(--border);background:var(--green-light)" onclick="
            navigator.clipboard.writeText(location.origin + '/join/<%= game.invite_code %>');
            this.textContent = '✓ Invite link copied!';
            setTimeout(() => this.textContent = '🔗 Share invite link', 2000);
          ">🔗 Share invite link</button>
        <% } %>
        <button class="btn btn-sm btn-ghost" style="color:var(--text-muted);border-color:var(--border)" onclick="
          navigator.clipboard.writeText(location.href);
          this.textContent = '✓ Copied!';
          setTimeout(() => this.textContent = '📋 Share leaderboard', 2000);
        ">📋 Share leaderboard</button>
      </div>
    </div>

    <!-- ── Submit pick CTA ──────────────────────────────────────────── -->
    <% if (user && !alreadyJoined && !game.is_complete) { %>
      <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap">
        <p style="margin:0">You're not in this game yet.</p>
        <form action="/game/<%= game.id %>/join" method="POST" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn" style="background:var(--green);color:#fff">Join game</button>
        </form>
      </div>
    <% } else if (alreadyJoined && !game.is_started) { %>
      <div class="card" style="background:#f8fafc;border:1px solid var(--border)">
        <p style="margin:0">⏳ The host hasn't started the game yet — check back once it begins.</p>
      </div>
    <% } else if (canPick) { %>
      <% const deadlineSoon = weekObj?.deadline && (new Date(weekObj.deadline).getTime() - Date.now()) <= 6 * 60 * 60 * 1000; %>
      <% if (deadlineSoon) { %>
        <div class="deadline-banner">
          <span>⏳ You haven't picked yet this week — pick before the deadline or you're <strong>OUT!</strong></span>
          <span class="countdown-timer" data-deadline="<%= new Date(weekObj.deadline).toISOString() %>">…</span>
        </div>
      <% } %>
      <div class="card" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;background:#fffbeb;border:1px solid #f59e0b">
        <div>
          <strong>Week <%= currentWeek %> — make your pick!</strong>
          <% if (weekObj?.deadline) { %>
            <span class="muted" style="font-size:.85rem;display:block;margin-top:.2rem">Deadline: <%= new Date(weekObj.deadline).toLocaleString('en-GB', { timeZone:'Europe/London', day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %></span>
          <% } else if (canManage) { %>
            <span class="muted" style="font-size:.85rem;display:block;margin-top:.2rem">No deadline set yet — add one in Host Controls below.</span>
          <% } else { %>
            <span class="muted" style="font-size:.85rem;display:block;margin-top:.2rem">No deadline set yet.</span>
          <% } %>
        </div>
        <a href="/game/<%= game.id %>/lms/picks" class="btn" style="background:#f59e0b;color:#1a1a1a">Make your pick</a>
      </div>
    <% } else if (alreadyJoined && myStanding?.myCurrentPick && !weekObj?.results_locked) { %>
      <div class="card" style="background:#f0fdf4;border:1px solid var(--green)">
        Week <%= currentWeek %> pick: <strong><%= myStanding.myCurrentPick.team_name %></strong> — awaiting result.
      </div>
    <% } else if (alreadyJoined && myStanding?.eliminated) { %>
      <div class="card" style="background:#fef2f2;border:1px solid #ef4444">
        <% if (myStanding.eliminatedReason === 'no_pick') { %>
          💀 <strong>UR OUTTT!</strong> You didn't pick before the week <%= myStanding.eliminatedWeek %> deadline.
        <% } else { %>
          You were eliminated in week <%= myStanding.eliminatedWeek %>. Better luck next time!
        <% } %>
      </div>
    <% } %>

    <!-- ── Standings ────────────────────────────────────────────────── -->
    <h2 class="section-title mt-lg">Standings</h2>
    <div class="card">
      <% if (standings.length === 0) { %>
        <p class="muted">No players yet.</p>
      <% } else { %>
        <div class="leaderboard-table-wrap">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th>Player</th>
              <th>Status</th>
              <% if (game.prize_individual > 0) { %><th>💰</th><% } %>
              <% for (let w = 1; w <= currentWeek; w++) { %>
                <th>Wk <%= w %></th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <%
              const alive_standings = standings.filter(s => !s.eliminated);
              const elim_standings  = standings.filter(s => s.eliminated)
                .sort((a,b) => b.eliminatedWeek - a.eliminatedWeek);
              const sorted_standings = [...alive_standings, ...elim_standings];
            %>
            <% sorted_standings.forEach(s => { %>
              <% const isMe = user && s.user_id === user.id; %>
              <tr class="<%= isMe ? 'my-row' : '' %> <%= s.eliminated ? 'lms-eliminated' : '' %>">
                <td>
                  <span style="display:inline-flex;align-items:center;gap:.4rem">
                    <%- include('partials/player-avatar', { avatar: s.avatar, username: s.username }) %>
                    <% if (s.team_name) { %>
                      <span>
                        <strong><%= s.team_name.length > 22 ? s.team_name.slice(0, 22) + '…' : s.team_name %></strong>
                        <br /><span class="muted" style="font-size:.75rem"><%= s.username %></span>
                      </span>
                    <% } else { %>
                      <strong><%= s.username %></strong>
                    <% } %>
                  </span>
                </td>
                <td>
                  <% if (!s.eliminated) { %>
                    <span class="status-badge status-live">Alive</span>
                  <% } else { %>
                    <span class="status-badge status-done">Out W<%= s.eliminatedWeek %></span>
                  <% } %>
                </td>
                <% if (game.prize_individual > 0) { %>
                  <td style="text-align:center"><%= s.has_paid ? '✓' : '' %></td>
                <% } %>
                <% for (let w = 1; w <= currentWeek; w++) { %>
                  <%
                    const pick = s.picks.find(p => p.week_number === w);
                    const weekLocked = weeks.find(wk => wk.week_number === w)?.results_locked;
                    const isPastWeek = w < currentWeek;
                    // Current week picks are hidden until everyone has submitted
                    const revealThisWeek = w < currentWeek || allPickedIn || weekLocked;
                    const isMyPick = user && s.user_id === user.id;
                  %>
                  <td class="lms-pick-cell">
                    <% if (pick) { %>
                      <% if (!revealThisWeek && !isMyPick) { %>
                        <span class="lms-pick pending" title="Waiting for all picks">🔒</span>
                      <% } else if (pick.result === 'win') { %>
                        <span class="lms-pick win"><%= pick.team_name %> ✓</span>
                      <% } else if (pick.result === 'loss') { %>
                        <span class="lms-pick loss"><%= pick.team_name %> ✗</span>
                      <% } else if (pick.result === 'draw') { %>
                        <span class="lms-pick draw"><%= pick.team_name %> ═</span>
                      <% } else { %>
                        <span class="lms-pick pending"><%= pick.team_name %></span>
                      <% } %>
                    <% } else if (weekLocked || isPastWeek) { %>
                      <span class="lms-pick no-pick">No pick</span>
                    <% } else if (!revealThisWeek) { %>
                      <span class="muted">—</span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                <% } %>

                <!-- Host override controls -->
                <% if (canManage && weeks.find(w2 => w2.week_number === currentWeek)?.results_locked) { %>
                  <% const curPick = s.picks.find(p => p.week_number === currentWeek); %>
                  <% if (curPick && curPick.result === 'pending') { %>
                  <td>
                    <form action="/game/<%= game.id %>/lms/override-result" method="POST" style="display:inline;white-space:nowrap">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="pick_id" value="<%= curPick.id %>" />
                      <select name="result" style="font-size:.78rem;padding:.15rem .3rem;border:1px solid var(--border);border-radius:4px">
                        <option value="pending">pending</option>
                        <option value="win">win</option>
                        <option value="loss">loss</option>
                        <option value="draw">draw</option>
                      </select>
                      <button type="submit" class="btn btn-sm" style="padding:.15rem .4rem;font-size:.78rem">Set</button>
                    </form>
                  </td>
                  <% } else { %><td></td><% } %>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } %>
    </div>

    <!-- ── Host controls ─────────────────────────────────────────────── -->
    <% if (canManage) { %>
      <details style="display:inline-block;margin-top:1rem;position:relative">
        <summary class="btn btn-sm btn-ghost" style="cursor:pointer;list-style:none;color:var(--text-muted)">⚙ Host controls</summary>
        <div style="position:absolute;top:calc(100% + .3rem);left:0;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:.6rem;display:flex;flex-direction:column;gap:.5rem;min-width:230px;z-index:10;box-shadow:0 4px 12px rgba(0,0,0,.08)">

          <% if (isHost && participants.length > 1) { %>
            <div>
              <p class="label-small" style="margin-bottom:.3rem">Co-hosts</p>
              <div style="display:flex;flex-direction:column;gap:.3rem">
                <% participants.filter(p => p.user_id !== game.host_user_id).forEach(p => { %>
                  <form action="/game/<%= game.id %>/draft/toggle-co-host" method="POST" style="display:flex;align-items:center;gap:.4rem">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="user_id" value="<%= p.user_id %>" />
                    <span style="flex:1;font-size:.82rem"><%= p.username %></span>
                    <button type="submit" class="btn btn-sm" style="padding:.15rem .4rem;font-size:.74rem;<%= p.is_co_host ? 'background:var(--green);color:#fff' : 'background:var(--card-border);color:var(--text)' %>">
                      <%= p.is_co_host ? '👑' : 'Make co-host' %>
                    </button>
                  </form>
                <% }) %>
              </div>
            </div>
          <% } %>

          <!-- Set deadline -->
          <div>
            <p class="label-small" style="margin-bottom:.3rem">Week <%= currentWeek %> deadline</p>
            <form action="/game/<%= game.id %>/lms/set-deadline" method="POST" style="display:flex;gap:.3rem;align-items:center;flex-wrap:wrap">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="datetime-local" name="deadline"
                     value="<%= weekObj?.deadline ? new Date(weekObj.deadline).toISOString().slice(0,16) : (suggestedDeadline ? new Date(suggestedDeadline).toISOString().slice(0,16) : '') %>"
                     style="padding:.3rem .5rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.82rem;width:100%" />
              <button type="submit" class="btn btn-sm" style="width:100%">Save deadline</button>
            </form>
          </div>

          <!-- Process results -->
          <form action="/game/<%= game.id %>/lms/process-results" method="POST"
                onsubmit="return confirm('Fetch results from ESPN and lock week <%= currentWeek %>? This cannot be undone.')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-sm" style="width:100%;background:var(--green);color:#fff">
              Process results — Wk <%= currentWeek %>
            </button>
          </form>

          <!-- Advance week -->
          <% if (weekObj?.results_locked) { %>
            <form action="/game/<%= game.id %>/lms/advance-week" method="POST"
                  onsubmit="return confirm('Move to week <%= currentWeek + 1 %>?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm" style="width:100%">Advance to week <%= currentWeek + 1 %></button>
            </form>
          <% } %>

          <!-- Stop auto-restart -->
          <% if (game.lms_continuous) { %>
            <form action="/game/<%= game.id %>/lms/stop" method="POST"
                  onsubmit="return confirm('Turn off auto-restart? This round will still finish normally, but the game will return to the lobby afterward instead of starting a new round.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm btn-danger" style="width:100%">⏹ Stop Game</button>
            </form>
          <% } %>

          <!-- Delete game -->
          <% if (isHost) { %>
            <form action="/game/<%= game.id %>/delete" method="POST"
                  onsubmit="return confirm('Delete this game and all picks? Cannot be undone.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm btn-danger" style="width:100%">Delete game</button>
            </form>
          <% } %>
        </div>
      </details>
    <% } %>

  </main>

  <script>
    (function() {
      function fmt(ms) {
        if (ms <= 0) return 'Deadline passed';
        const s = Math.floor(ms / 1000);
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const sec = s % 60;
        if (d > 0) return d + 'd ' + h + 'h left';
        if (h > 0) return h + 'h ' + m + 'm left';
        if (m > 0) return m + 'm ' + sec + 's left';
        return sec + 's left!';
      }
      function tick() {
        document.querySelectorAll('.countdown-timer[data-deadline]').forEach(function(el) {
          const ms = new Date(el.dataset.deadline).getTime() - Date.now();
          el.textContent = fmt(ms);
          el.classList.toggle('countdown-urgent', ms > 0 && ms < 3 * 60 * 60 * 1000);
          el.classList.toggle('countdown-critical', ms > 0 && ms < 10 * 60 * 1000);
        });
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

  <%- include('partials/footer') %>
</body>
</html>

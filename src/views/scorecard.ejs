<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= game.name %> – PickMates</title>
  <link rel="icon" href="/FavIcon.png" type="image/png" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates <span class="logo-sub"><%= game.name %></span></a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="page-header">
      <h1><%= game.name %></h1>
      <p class="muted" style="margin-top:.2rem">
        <span class="game-type-badge game-type-scorecard">⛳ Golf Scorecard</span>
        <% if (game.scorecard_course_name) { %>
          <span style="margin-left:.4rem"><%= game.scorecard_course_name %><% if (game.scorecard_course_par) { %> · Par <%= game.scorecard_course_par %><% } %></span>
        <% } %>
      </p>
      <% if (game.host_username) { %>
        <p class="muted" style="margin-top:.2rem;font-size:.85rem">👤 Hosted by <strong><%= game.host_username %></strong></p>
      <% } %>
      <% const isIndividual = game.scorecard_format === 'individual'; %>
      <% const totalPlayers = allParticipants.length; %>
      <% if (game.scorecard_entry_fee > 0) { %>
        <%
          const pot = game.scorecard_entry_fee * totalPlayers;
          let teamPrize = 0, indivPrize, ctpPrize;
          if (isIndividual) {
            indivPrize = Math.round(pot * 0.7);
            ctpPrize = pot - indivPrize; // remainder, so the two always sum to the pot
          } else {
            teamPrize = Math.round(pot * 0.5);
            indivPrize = Math.round(pot * 0.4);
            ctpPrize = pot - teamPrize - indivPrize; // remainder, so the three always sum to the pot
          }
        %>
        <p class="muted" style="margin-top:.2rem;font-size:.85rem">Prize pot: <strong>£<%= pot %></strong> <span class="muted" style="font-size:.78rem">(£<%= game.scorecard_entry_fee %> × <%= totalPlayers %> player<%= totalPlayers !== 1 ? 's' : '' %>)</span></p>
        <p class="muted" style="margin-top:.15rem;font-size:.8rem">
          <% if (!isIndividual) { %>
            🏆 Winning team: <strong>£<%= teamPrize %></strong>
            <span style="margin:0 .3rem">·</span>
          <% } %>
          ⛳ Individual net score: <strong>£<%= indivPrize %></strong>
          <span style="margin:0 .3rem">·</span>
          🎯 Nearest the pin: <strong>£<%= ctpPrize %></strong>
        </p>
      <% } %>
      <% if (game.tournament_complete && (game.winner_username || game.winner_individual_username)) { %>
        <p class="muted" style="margin-top:.3rem">🏆 <%= isIndividual ? 'Winner' : 'Winning team' %>: <strong><%= isIndividual ? game.winner_individual_username : game.winner_username %></strong></p>
      <% } %>
      <% if (user && (myParticipant || canManage)) { %>
        <p style="margin-top:.6rem">
          <a href="/game/<%= game.id %>/draft" class="btn btn-sm" style="background:#f59e0b;color:#1a1a1a">Lobby</a>
        </p>
      <% } %>
    </div>

    <% if (!game.is_started) { %>
      <div class="card" style="background:#f8fafc;border:1px solid var(--border)">
        <p style="margin:0">⏳ This game hasn't started yet. <a href="/game/<%= game.id %>/draft">Go to the lobby →</a></p>
      </div>
    <% } else { %>
      <%
        const ctpHolderByHole = new Map(closestToPin.map(c => [c.hole_number, c.holder ? c.holder.participant_id : null]));
        function canEditPlayer(p) {
          if (game.tournament_complete) return false;
          if (canManage) return true;
          if (!myParticipant) return false;
          if (myParticipant.participant_id === p.participant_id) return true;
          if (myParticipant.scorecard_tee_time_id && myParticipant.scorecard_tee_time_id === p.scorecard_tee_time_id) return true;
          return false;
        }
        const allScoresIn = isHost && !game.tournament_complete
          && allParticipants.length > 0 && allParticipants.every(p => p.thru === 18);
      %>

      <% if (!isIndividual && teeTimes.length > 0) { %>
        <div style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1rem" id="scorecard-tabs">
          <button type="button" class="btn btn-sm tab-btn" data-tab="all">All</button>
          <% teeTimes.forEach(tt => { %>
            <button type="button" class="btn btn-sm btn-outline tab-btn" data-tab="tt-<%= tt.id %>"><%= tt.label %></button>
          <% }) %>
        </div>
      <% } %>

      <div data-tab-panel="all">
      <!-- ── All scores in — offer to complete the game ────────────────────── -->
      <% if (allScoresIn) { %>
        <div class="card" style="margin-bottom:1.2rem;border:2px solid var(--gold);background:var(--gold-light);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.8rem">
          <div>
            <strong style="font-size:1rem">🏁 All scores are in!</strong>
            <p class="muted" style="margin-top:.2rem;font-size:.85rem">Every player has a score for all 18 holes. Ready to finalise the scorecard?</p>
          </div>
          <form action="/game/<%= game.id %>/complete" method="POST"
                onsubmit="return confirm('This will finalise the scorecard and complete the game. Continue?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn" style="background:var(--green);color:#fff">✅ Complete Game</button>
          </form>
        </div>
      <% } %>

      <!-- ── Standings ──────────────────────────────────────────────────── -->
      <% if (!isIndividual) { %>
        <h2 class="section-title mt-lg">Standings</h2>
        <p class="admin-hint" style="margin-bottom:.6rem">Only each team's best 3 Stableford scores count on every hole.</p>
        <div class="card">
          <% if (standings.length === 0) { %>
            <p class="muted">No teams yet.</p>
          <% } else { %>
            <div class="leaderboard-table-wrap">
              <table class="leaderboard-table">
                <thead>
                  <tr>
                    <th>Rank</th>
                    <th>Team</th>
                    <th>Points</th>
                    <th>Thru</th>
                  </tr>
                </thead>
                <tbody>
                  <% standings.forEach((t, i) => { %>
                    <tr>
                      <td>#<%= i + 1 %></td>
                      <td><strong><%= t.name %></strong> <span class="muted" style="font-size:.78rem">(<%= t.players.length %> player<%= t.players.length !== 1 ? 's' : '' %>)</span></td>
                      <td><strong><%= t.totalPoints %></strong> pts</td>
                      <td><%= t.thru %>/18</td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- ── Individual scoreboard ─────────────────────────────────────── -->
      <h2 class="section-title mt-lg"><%= isIndividual ? 'Standings' : '🏌️ Individual Scoreboard' %></h2>
      <div class="card">
        <% if (individualStandings.length === 0) { %>
          <p class="muted">No players yet.</p>
        <% } else { %>
          <div class="leaderboard-table-wrap">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Player</th>
                  <% if (!isIndividual) { %><th>Team</th><% } %>
                  <th>Thru</th>
                  <th>Points</th>
                </tr>
              </thead>
              <tbody>
                <% individualStandings.forEach((p, i) => { %>
                  <tr class="<%= myParticipant && p.participant_id === myParticipant.participant_id ? 'my-row' : '' %>">
                    <td>#<%= i + 1 %></td>
                    <td title="<%= p.username %>">
                      <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <%- include('partials/player-avatar', { avatar: p.avatar, username: p.username }) %>
                        <%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %>
                      </span>
                    </td>
                    <% if (!isIndividual) { %><td><%= p.team_name || '—' %></td><% } %>
                    <td><%= p.thru %>/18</td>
                    <td><strong><%= p.total18.points !== null ? p.total18.points : 0 %></strong> pts</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- ── Closest to the pin ────────────────────────────────────────── -->
      <% if (closestToPin.length > 0) { %>
        <%
          const ctpEditable = !game.tournament_complete && (canManage || (myParticipant && (isIndividual || myParticipant.scorecard_tee_time_id)));
        %>
        <h2 class="section-title mt-lg">🎯 Closest to the Pin</h2>
        <div class="card">
          <div class="leaderboard-table-wrap">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Hole</th>
                  <th>Current holder</th>
                  <% if (ctpEditable) { %><th>Set</th><% } %>
                </tr>
              </thead>
              <tbody>
                <% closestToPin.forEach(c => { %>
                  <tr>
                    <td>#<%= c.hole_number %></td>
                    <td>
                      <% if (c.holder) { %>
                        🎯 <strong><%= c.holder.username %></strong>
                        <% if (c.holder.team_name) { %><span class="muted" style="font-size:.78rem"> (<%= c.holder.team_name %>)</span><% } %>
                      <% } else { %>
                        <span class="muted">Not set</span>
                      <% } %>
                    </td>
                    <% if (ctpEditable) { %>
                      <td>
                        <form action="/game/<%= game.id %>/scorecard/closest-to-pin" method="POST" style="display:flex;gap:.4rem;align-items:center">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="hole_number" value="<%= c.hole_number %>" />
                          <select name="participant_id" style="padding:.3rem .4rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.8rem;max-width:110px">
                            <% allParticipants.forEach(p => { %>
                              <option value="<%= p.participant_id %>" <%= c.holder && c.holder.participant_id === p.participant_id ? 'selected' : '' %>>
                                <%= p.username %>
                              </option>
                            <% }) %>
                          </select>
                          <button type="submit" class="btn btn-sm" style="padding:.15rem .4rem;font-size:.72rem">Set</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- ── Per-team scorecards ────────────────────────────────────────── -->
      <p class="admin-hint" style="margin-bottom:.8rem">
        <span class="score-eagle">● Eagle</span>
        <span style="margin:0 .3rem">·</span>
        <span class="score-birdie">● Birdie</span>
        <span style="margin:0 .3rem">·</span>
        <span class="score-par">● Par</span>
        <span style="margin:0 .3rem">·</span>
        <span class="score-bogey">● Bogey</span>
        <span style="margin:0 .3rem">·</span>
        <span class="score-double">● Double bogey</span>
        <span style="margin:0 .3rem">·</span>
        <span class="score-other">● Triple Bogey+</span>
      </p>
      <% if (isIndividual) { %>
        <%
          const anyEditable = allParticipants.some(p => canEditPlayer(p));
        %>
        <h2 class="section-title mt-lg">Scorecard</h2>
        <div class="card">
          <% if (allParticipants.length === 0) { %>
            <p class="muted">No players yet.</p>
          <% } else { %>
            <% if (anyEditable) { %>
              <form action="/game/<%= game.id %>/scorecard/scores#all" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } %>
            <div class="leaderboard-table-wrap">
              <table class="leaderboard-table">
                <thead>
                  <tr>
                    <th>Hole</th>
                    <th>Par</th>
                    <th>SI</th>
                    <% allParticipants.forEach(p => { %>
                      <th title="<%= p.username %>" style="font-weight:500;text-transform:none"><%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% holes.forEach(h => { %>
                    <tr>
                      <td><%= h.hole_number %></td>
                      <td><%= h.par %></td>
                      <td><%= h.stroke_index %></td>
                      <% allParticipants.forEach(p => {
                        const hs = p.holeScores.find(x => x.hole_number === h.hole_number);
                        const scoreClass = hs && hs.scoreClass ? hs.scoreClass : '';
                        const cellEditable = canEditPlayer(p);
                      %>
                        <td>
                          <% if (cellEditable) { %>
                            <input type="number" name="strokes_<%= p.participant_id %>_<%= h.hole_number %>" min="1" max="15"
                                   value="<%= hs && hs.strokes !== null ? hs.strokes : '' %>"
                                   class="<%= scoreClass %>"
                                   style="width:55px;padding:.25rem .35rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem" />
                          <% } else { %>
                            <span class="<%= scoreClass %>"><%= hs && hs.strokes !== null ? hs.strokes : '—' %></span>
                          <% } %>
                          <% if (hs && hs.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= hs.points %>pt)</span><% } %>
                          <% if (ctpHolderByHole.get(h.hole_number) === p.participant_id) { %><span title="Closest to the pin">🎯</span><% } %>
                        </td>
                      <% }) %>
                    </tr>
                    <% if (h.hole_number === 9) { %>
                      <tr style="font-weight:700;background:var(--green-light)">
                        <td colspan="3">OUT</td>
                        <% allParticipants.forEach(p => { %>
                          <td>
                            <%= p.front9.strokes !== null ? p.front9.strokes : '—' %>
                            <% if (p.front9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.front9.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                      </tr>
                      <tr style="font-size:.72rem;color:var(--text-muted);background:var(--bg)">
                        <td colspan="3">Back 9 →</td>
                        <% allParticipants.forEach(p => { %>
                          <td title="<%= p.username %>"><%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %></td>
                        <% }) %>
                      </tr>
                    <% } %>
                    <% if (h.hole_number === 18) { %>
                      <tr style="font-weight:700;background:var(--green-light)">
                        <td colspan="3">IN</td>
                        <% allParticipants.forEach(p => { %>
                          <td>
                            <%= p.back9.strokes !== null ? p.back9.strokes : '—' %>
                            <% if (p.back9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.back9.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                      </tr>
                      <tr style="font-weight:700">
                        <td colspan="3">TOTAL</td>
                        <% allParticipants.forEach(p => { %>
                          <td>
                            <%= p.total18.strokes !== null ? p.total18.strokes : '—' %>
                            <% if (p.total18.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.total18.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (anyEditable) { %>
                <button type="submit" class="btn btn-sm" style="margin-top:.6rem;background:var(--green);color:#fff">Save Scores</button>
              </form>
            <% } %>
          <% } %>
        </div>
      <% } else { %>
      <% teams.forEach(team => { %>
        <%
          const teamHasEditable = team.players.some(p => canEditPlayer(p));
        %>
        <h2 class="section-title mt-lg"><%= team.name %> <span class="muted" style="font-size:.85rem;font-weight:400">— <%= team.totalPoints %> pts</span></h2>
        <div class="card">
          <% if (team.players.length === 0) { %>
            <p class="muted">No players on this team.</p>
          <% } else { %>
            <% if (teamHasEditable) { %>
              <form action="/game/<%= game.id %>/scorecard/scores#all" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } %>
            <div class="leaderboard-table-wrap">
              <table class="leaderboard-table">
                <thead>
                  <tr>
                    <th>Hole</th>
                    <th>Par</th>
                    <th>SI</th>
                    <% team.players.forEach(p => { %>
                      <th title="<%= p.username %>" style="font-weight:500;text-transform:none"><%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %></th>
                    <% }) %>
                    <th>Team pts</th>
                  </tr>
                </thead>
                <tbody>
                  <% holes.forEach((h, hIdx) => { %>
                    <tr>
                      <td><%= h.hole_number %></td>
                      <td><%= h.par %></td>
                      <td><%= h.stroke_index %></td>
                      <% team.players.forEach(p => {
                        const hs = p.holeScores.find(x => x.hole_number === h.hole_number);
                        const scoreClass = hs && hs.scoreClass ? hs.scoreClass : '';
                        const cellEditable = canEditPlayer(p);
                      %>
                        <td>
                          <% if (cellEditable) { %>
                            <input type="number" name="strokes_<%= p.participant_id %>_<%= h.hole_number %>" min="1" max="15"
                                   value="<%= hs && hs.strokes !== null ? hs.strokes : '' %>"
                                   class="<%= scoreClass %>"
                                   style="width:55px;padding:.25rem .35rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem" />
                          <% } else { %>
                            <span class="<%= scoreClass %>"><%= hs && hs.strokes !== null ? hs.strokes : '—' %></span>
                          <% } %>
                          <% if (hs && hs.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= hs.points %>pt)</span><% } %>
                          <% if (ctpHolderByHole.get(h.hole_number) === p.participant_id) { %><span title="Closest to the pin">🎯</span><% } %>
                        </td>
                      <% }) %>
                      <td><%= team.holeTotals[hIdx] !== null ? team.holeTotals[hIdx] : '—' %></td>
                    </tr>
                    <% if (h.hole_number === 9) { %>
                      <tr style="font-weight:700;background:var(--green-light)">
                        <td colspan="3">OUT</td>
                        <% team.players.forEach(p => { %>
                          <td>
                            <%= p.front9.strokes !== null ? p.front9.strokes : '—' %>
                            <% if (p.front9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.front9.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                        <td><%= team.frontPoints !== null ? team.frontPoints : '—' %> pts</td>
                      </tr>
                      <tr style="font-size:.72rem;color:var(--text-muted);background:var(--bg)">
                        <td colspan="3">Back 9 →</td>
                        <% team.players.forEach(p => { %>
                          <td title="<%= p.username %>"><%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %></td>
                        <% }) %>
                        <td></td>
                      </tr>
                    <% } %>
                    <% if (h.hole_number === 18) { %>
                      <tr style="font-weight:700;background:var(--green-light)">
                        <td colspan="3">IN</td>
                        <% team.players.forEach(p => { %>
                          <td>
                            <%= p.back9.strokes !== null ? p.back9.strokes : '—' %>
                            <% if (p.back9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.back9.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                        <td><%= team.backPoints !== null ? team.backPoints : '—' %> pts</td>
                      </tr>
                      <tr style="font-weight:700">
                        <td colspan="3">TOTAL</td>
                        <% team.players.forEach(p => { %>
                          <td>
                            <%= p.total18.strokes !== null ? p.total18.strokes : '—' %>
                            <% if (p.total18.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.total18.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                        <td><%= team.totalPoints %> pts</td>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (teamHasEditable) { %>
                <button type="submit" class="btn btn-sm" style="margin-top:.6rem;background:var(--green);color:#fff">Save Scores</button>
              </form>
            <% } %>
          <% } %>
        </div>
      <% }) %>
      <% } %>
      </div>

      <% teeTimes.forEach(tt => { %>
        <% const ttHasEditable = tt.players.some(p => canEditPlayer(p)); %>
        <div data-tab-panel="tt-<%= tt.id %>" style="display:none">
          <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem">
            <h2 class="section-title mt-lg" style="margin-bottom:0"><%= tt.label %></h2>
            <% if (ttHasEditable) { %>
              <button type="submit" form="tee-time-form-<%= tt.id %>" class="btn btn-sm" style="background:var(--green);color:#fff">Save Scores</button>
            <% } %>
          </div>
          <div class="card">
            <% if (tt.players.length === 0) { %>
              <p class="muted">No players in this tee time yet.</p>
            <% } else { %>
              <% if (ttHasEditable) { %>
                <form id="tee-time-form-<%= tt.id %>" action="/game/<%= game.id %>/scorecard/scores#tt-<%= tt.id %>" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <% } %>
              <div class="leaderboard-table-wrap">
                <table class="leaderboard-table">
                  <thead>
                    <tr>
                      <th>Hole</th>
                      <th>Par</th>
                      <th>SI</th>
                      <% tt.players.forEach(p => { %>
                        <th title="<%= p.username %>" style="font-weight:500;text-transform:none">
                          <%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %>
                          <% if (p.team_name) { %><br /><span class="muted" style="font-size:.68rem;font-weight:400"><%= p.team_name %></span><% } %>
                        </th>
                      <% }) %>
                    </tr>
                  </thead>
                  <tbody>
                    <% holes.forEach(h => { %>
                      <tr>
                        <td><%= h.hole_number %></td>
                        <td><%= h.par %></td>
                        <td><%= h.stroke_index %></td>
                        <% tt.players.forEach(p => {
                          const hs = p.holeScores.find(x => x.hole_number === h.hole_number);
                          const scoreClass = hs && hs.scoreClass ? hs.scoreClass : '';
                          const cellEditable = canEditPlayer(p);
                        %>
                          <td>
                            <% if (cellEditable) { %>
                              <input type="number" name="strokes_<%= p.participant_id %>_<%= h.hole_number %>" min="1" max="15"
                                     value="<%= hs && hs.strokes !== null ? hs.strokes : '' %>"
                                     class="<%= scoreClass %>"
                                     style="width:55px;padding:.25rem .35rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem" />
                            <% } else { %>
                              <span class="<%= scoreClass %>"><%= hs && hs.strokes !== null ? hs.strokes : '—' %></span>
                            <% } %>
                            <% if (hs && hs.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= hs.points %>pt)</span><% } %>
                            <% if (ctpHolderByHole.get(h.hole_number) === p.participant_id) { %><span title="Closest to the pin">🎯</span><% } %>
                          </td>
                        <% }) %>
                      </tr>
                      <% if (h.hole_number === 9) { %>
                        <tr style="font-weight:700;background:var(--green-light)">
                          <td colspan="3">OUT</td>
                          <% tt.players.forEach(p => { %>
                            <td>
                              <%= p.front9.strokes !== null ? p.front9.strokes : '—' %>
                              <% if (p.front9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.front9.points %>pt)</span><% } %>
                            </td>
                          <% }) %>
                        </tr>
                        <tr style="font-size:.72rem;color:var(--text-muted);background:var(--bg)">
                          <td colspan="3">Back 9 →</td>
                          <% tt.players.forEach(p => { %>
                            <td title="<%= p.username %>"><%= p.username.length > 9 ? p.username.slice(0, 9) + '…' : p.username %></td>
                          <% }) %>
                        </tr>
                      <% } %>
                      <% if (h.hole_number === 18) { %>
                        <tr style="font-weight:700;background:var(--green-light)">
                          <td colspan="3">IN</td>
                          <% tt.players.forEach(p => { %>
                            <td>
                              <%= p.back9.strokes !== null ? p.back9.strokes : '—' %>
                              <% if (p.back9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.back9.points %>pt)</span><% } %>
                            </td>
                          <% }) %>
                        </tr>
                        <tr style="font-weight:700">
                          <td colspan="3">TOTAL</td>
                          <% tt.players.forEach(p => { %>
                            <td>
                              <%= p.total18.strokes !== null ? p.total18.strokes : '—' %>
                              <% if (p.total18.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.total18.points %>pt)</span><% } %>
                            </td>
                          <% }) %>
                        </tr>
                      <% } %>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <% if (ttHasEditable) { %>
                <button type="submit" class="btn btn-sm" style="margin-top:.6rem;background:var(--green);color:#fff">Save Scores</button>
                </form>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>

    <!-- ── Host controls ─────────────────────────────────────────────────── -->
    <% if (canManage) { %>
      <details style="display:inline-block;margin-top:1rem;position:relative">
        <summary class="btn btn-sm btn-ghost" style="cursor:pointer;list-style:none;color:var(--text-muted)">⚙ Host controls</summary>
        <div style="position:absolute;top:calc(100% + .3rem);left:0;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:.6rem;display:flex;flex-direction:column;gap:.5rem;min-width:220px;z-index:10;box-shadow:0 4px 12px rgba(0,0,0,.08)">
          <% if (parThreeHoles.length > 0) { %>
            <div>
              <p class="label-small" style="margin-bottom:.3rem">Closest to the Pin holes</p>
              <form action="/game/<%= game.id %>/scorecard/ctp-holes" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.4rem">
                  <% parThreeHoles.forEach(h => { %>
                    <label style="display:flex;align-items:center;gap:.3rem;font-size:.78rem;cursor:pointer">
                      <input type="checkbox" name="ctp_holes" value="<%= h.hole_number %>" <%= h.is_ctp ? 'checked' : '' %> />
                      #<%= h.hole_number %>
                    </label>
                  <% }) %>
                </div>
                <button type="submit" class="btn btn-sm" style="width:100%">Save</button>
              </form>
            </div>
            <div class="admin-divider"></div>
          <% } %>
          <% if (!game.tournament_complete && isHost) { %>
            <form action="/game/<%= game.id %>/complete" method="POST"
                  onsubmit="return confirm('Mark this game complete? <%= isIndividual ? 'This locks in the winner.' : 'This locks in the winning team.' %>')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm" style="width:100%;background:var(--green);color:#fff">Mark complete</button>
            </form>
          <% } %>
          <% if (isHost && game.is_started) { %>
            <form action="/game/<%= game.id %>/scorecard/reset-scores" method="POST"
                  onsubmit="return confirm('Reset all entered scores? This clears every hole for every player and cannot be undone.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm btn-danger" style="width:100%">Reset scores</button>
            </form>
          <% } %>
          <% if (isHost) { %>
            <form action="/game/<%= game.id %>/delete" method="POST"
                  onsubmit="return confirm('Delete this game and all scores? Cannot be undone.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button type="submit" class="btn btn-sm btn-danger" style="width:100%">Delete game</button>
            </form>
          <% } %>
        </div>
      </details>
    <% } %>
  </main>

  <script>
    (function() {
      const tabsBar = document.getElementById('scorecard-tabs');
      if (!tabsBar) return;
      const buttons = tabsBar.querySelectorAll('.tab-btn');
      const panels  = document.querySelectorAll('[data-tab-panel]');

      function activate(tab) {
        buttons.forEach(b => b.classList.toggle('btn-outline', b.dataset.tab !== tab));
        panels.forEach(p => { p.style.display = p.dataset.tabPanel === tab ? '' : 'none'; });
      }

      buttons.forEach(b => {
        b.addEventListener('click', () => {
          activate(b.dataset.tab);
          history.replaceState(null, '', '#' + b.dataset.tab);
        });
      });

      const requested = (location.hash || '').slice(1);
      let hasPanel = false;
      try { hasPanel = !!document.querySelector('[data-tab-panel="' + requested + '"]'); } catch (e) {}
      activate(hasPanel ? requested : 'all');
    })();
  </script>

  <%- include('partials/footer') %>
</body>
</html>

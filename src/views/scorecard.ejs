<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= game.name %> – PickMates</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><span class="logo-flag">⛳</span> PickMates <span class="logo-sub"><%= game.name %></span></a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <div class="page-header">
      <h1><%= game.name %></h1>
      <p class="muted" style="margin-top:.2rem">
        <span class="game-type-badge game-type-scorecard">⛳ Golf Scorecard</span>
        <% if (game.scorecard_course_name) { %>
          <span style="margin-left:.4rem"><%= game.scorecard_course_name %><% if (game.scorecard_course_par) { %> · Par <%= game.scorecard_course_par %><% } %></span>
        <% } %>
      </p>
      <% if (game.host_username) { %>
        <p class="muted" style="margin-top:.2rem;font-size:.85rem">👤 Hosted by <strong><%= game.host_username %></strong></p>
      <% } %>
      <% const totalPlayers = teams.reduce((s, t) => s + t.players.length, 0) + unassignedParticipants.length; %>
      <% if (game.scorecard_entry_fee > 0) { %>
        <%
          const pot = game.scorecard_entry_fee * totalPlayers;
          const teamPrize = Math.round(pot * 0.5);
          const indivPrize = Math.round(pot * 0.4);
          const ctpPrize = pot - teamPrize - indivPrize; // remainder, so the three always sum to the pot
        %>
        <p class="muted" style="margin-top:.2rem;font-size:.85rem">Prize pot: <strong>£<%= pot %></strong> <span class="muted" style="font-size:.78rem">(£<%= game.scorecard_entry_fee %> × <%= totalPlayers %> player<%= totalPlayers !== 1 ? 's' : '' %>)</span></p>
        <p class="muted" style="margin-top:.15rem;font-size:.8rem">
          🏆 Winning team: <strong>£<%= teamPrize %></strong>
          <span style="margin:0 .3rem">·</span>
          ⛳ Individual net score: <strong>£<%= indivPrize %></strong>
          <span style="margin:0 .3rem">·</span>
          🎯 Nearest the pin: <strong>£<%= ctpPrize %></strong>
        </p>
      <% } %>
      <% if (game.tournament_complete && game.winner_username) { %>
        <p class="muted" style="margin-top:.3rem">🏆 Winning team: <strong><%= game.winner_username %></strong></p>
      <% } %>
      <% if (user && (myParticipant || canManage)) { %>
        <p style="margin-top:.6rem">
          <a href="/game/<%= game.id %>/draft" class="btn btn-sm" style="background:#f59e0b;color:#1a1a1a">Lobby</a>
        </p>
      <% } %>
    </div>

    <% if (!game.is_started) { %>
      <div class="card" style="background:#f8fafc;border:1px solid var(--border)">
        <p style="margin:0">⏳ This game hasn't started yet. <a href="/game/<%= game.id %>/draft">Go to the lobby →</a></p>
      </div>
    <% } else { %>

      <!-- ── Standings ──────────────────────────────────────────────────── -->
      <h2 class="section-title mt-lg">Standings</h2>
      <p class="admin-hint" style="margin-bottom:.6rem">Only each team's best 3 Stableford scores count on every hole.</p>
      <div class="card">
        <% if (standings.length === 0) { %>
          <p class="muted">No teams yet.</p>
        <% } else { %>
          <div class="leaderboard-table-wrap">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Team</th>
                  <th>Points</th>
                  <th>Thru</th>
                </tr>
              </thead>
              <tbody>
                <% standings.forEach((t, i) => { %>
                  <tr>
                    <td>#<%= i + 1 %></td>
                    <td><strong><%= t.name %></strong> <span class="muted" style="font-size:.78rem">(<%= t.players.length %> player<%= t.players.length !== 1 ? 's' : '' %>)</span></td>
                    <td><strong><%= t.totalPoints %></strong> pts</td>
                    <td><%= t.thru %>/18</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- ── Individual scoreboard ─────────────────────────────────────── -->
      <h2 class="section-title mt-lg">🏌️ Individual Scoreboard</h2>
      <div class="card">
        <% if (individualStandings.length === 0) { %>
          <p class="muted">No players yet.</p>
        <% } else { %>
          <div class="leaderboard-table-wrap">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Player</th>
                  <th>Team</th>
                  <th>Thru</th>
                  <th>Points</th>
                </tr>
              </thead>
              <tbody>
                <% individualStandings.forEach((p, i) => { %>
                  <tr class="<%= myParticipant && p.participant_id === myParticipant.participant_id ? 'my-row' : '' %>">
                    <td>#<%= i + 1 %></td>
                    <td><%= p.username %><% if (p.is_captain) { %> ⭐<% } %></td>
                    <td><%= p.team_name || '—' %></td>
                    <td><%= p.thru %>/18</td>
                    <td><strong><%= p.total18.points !== null ? p.total18.points : 0 %></strong> pts</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- ── Closest to the pin ────────────────────────────────────────── -->
      <% if (closestToPin.length > 0) { %>
        <%
          const ctpEditable = !game.tournament_complete && (canManage || (myParticipant && myParticipant.is_captain));
        %>
        <h2 class="section-title mt-lg">🎯 Closest to the Pin</h2>
        <div class="card">
          <div class="leaderboard-table-wrap">
            <table class="leaderboard-table">
              <thead>
                <tr>
                  <th>Hole</th>
                  <th>Current holder</th>
                  <% if (ctpEditable) { %><th>Set</th><% } %>
                </tr>
              </thead>
              <tbody>
                <% closestToPin.forEach(c => { %>
                  <tr>
                    <td>#<%= c.hole_number %></td>
                    <td>
                      <% if (c.holder) { %>
                        🎯 <strong><%= c.holder.username %></strong>
                        <% if (c.holder.team_name) { %><span class="muted" style="font-size:.78rem"> (<%= c.holder.team_name %>)</span><% } %>
                      <% } else { %>
                        <span class="muted">Not set</span>
                      <% } %>
                    </td>
                    <% if (ctpEditable) { %>
                      <td>
                        <form action="/game/<%= game.id %>/scorecard/closest-to-pin" method="POST" style="display:flex;gap:.4rem;align-items:center">
                          <input type="hidden" name="hole_number" value="<%= c.hole_number %>" />
                          <select name="participant_id" style="padding:.3rem .4rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.8rem;max-width:110px">
                            <% allParticipants.forEach(p => { %>
                              <option value="<%= p.participant_id %>" <%= c.holder && c.holder.participant_id === p.participant_id ? 'selected' : '' %>>
                                <%= p.username %>
                              </option>
                            <% }) %>
                          </select>
                          <button type="submit" class="btn btn-sm" style="padding:.15rem .4rem;font-size:.72rem">Set</button>
                        </form>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- ── Per-team scorecards ────────────────────────────────────────── -->
      <% const ctpHolderByHole = new Map(closestToPin.map(c => [c.hole_number, c.holder ? c.holder.participant_id : null])); %>
      <% teams.forEach(team => { %>
        <%
          const editable = !game.tournament_complete && (canManage || (myParticipant && myParticipant.is_captain && myParticipant.scorecard_team_id === team.id));
        %>
        <h2 class="section-title mt-lg"><%= team.name %> <span class="muted" style="font-size:.85rem;font-weight:400">— <%= team.totalPoints %> pts</span></h2>
        <div class="card">
          <% if (team.players.length === 0) { %>
            <p class="muted">No players on this team.</p>
          <% } else { %>
            <% if (editable) { %>
              <form action="/game/<%= game.id %>/scorecard/scores" method="POST">
                <input type="hidden" name="team_id" value="<%= team.id %>" />
            <% } %>
            <div class="leaderboard-table-wrap">
              <table class="leaderboard-table">
                <thead>
                  <tr>
                    <th>Hole</th>
                    <th>Par</th>
                    <th>SI</th>
                    <% team.players.forEach(p => { %>
                      <th title="<%= p.username %>" style="font-weight:500;text-transform:none"><%= p.username.length > 10 ? p.username.slice(0, 10) + '…' : p.username %><% if (p.is_captain) { %> ⭐<% } %></th>
                    <% }) %>
                    <th>Team pts</th>
                  </tr>
                </thead>
                <tbody>
                  <% holes.forEach((h, hIdx) => { %>
                    <tr>
                      <td><%= h.hole_number %></td>
                      <td><%= h.par %></td>
                      <td><%= h.stroke_index %></td>
                      <% team.players.forEach(p => {
                        const hs = p.holeScores.find(x => x.hole_number === h.hole_number);
                      %>
                        <td>
                          <% if (editable) { %>
                            <input type="number" name="strokes_<%= p.participant_id %>_<%= h.hole_number %>" min="1" max="15"
                                   value="<%= hs && hs.strokes !== null ? hs.strokes : '' %>"
                                   style="width:55px;padding:.25rem .35rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.85rem" />
                          <% } else { %>
                            <%= hs && hs.strokes !== null ? hs.strokes : '—' %>
                          <% } %>
                          <% if (hs && hs.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= hs.points %>pt)</span><% } %>
                          <% if (ctpHolderByHole.get(h.hole_number) === p.participant_id) { %><span title="Closest to the pin">🎯</span><% } %>
                        </td>
                      <% }) %>
                      <td><%= team.holeTotals[hIdx] !== null ? team.holeTotals[hIdx] : '—' %></td>
                    </tr>
                    <% if (h.hole_number === 9) { %>
                      <tr style="font-weight:700;background:var(--green-light)">
                        <td colspan="3">OUT</td>
                        <% team.players.forEach(p => { %>
                          <td>
                            <%= p.front9.strokes !== null ? p.front9.strokes : '—' %>
                            <% if (p.front9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.front9.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                        <td><%= team.frontPoints !== null ? team.frontPoints : '—' %> pts</td>
                      </tr>
                      <tr style="font-size:.72rem;color:var(--text-muted);background:var(--bg)">
                        <td colspan="3">Back 9 →</td>
                        <% team.players.forEach(p => { %>
                          <td title="<%= p.username %>"><%= p.username.length > 10 ? p.username.slice(0, 10) + '…' : p.username %><% if (p.is_captain) { %> ⭐<% } %></td>
                        <% }) %>
                        <td></td>
                      </tr>
                    <% } %>
                    <% if (h.hole_number === 18) { %>
                      <tr style="font-weight:700;background:var(--green-light)">
                        <td colspan="3">IN</td>
                        <% team.players.forEach(p => { %>
                          <td>
                            <%= p.back9.strokes !== null ? p.back9.strokes : '—' %>
                            <% if (p.back9.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.back9.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                        <td><%= team.backPoints !== null ? team.backPoints : '—' %> pts</td>
                      </tr>
                      <tr style="font-weight:700">
                        <td colspan="3">TOTAL</td>
                        <% team.players.forEach(p => { %>
                          <td>
                            <%= p.total18.strokes !== null ? p.total18.strokes : '—' %>
                            <% if (p.total18.points !== null) { %><span class="muted" style="font-size:.72rem"> (<%= p.total18.points %>pt)</span><% } %>
                          </td>
                        <% }) %>
                        <td><%= team.totalPoints %> pts</td>
                      </tr>
                    <% } %>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (editable) { %>
                <button type="submit" class="btn btn-sm" style="margin-top:.6rem;background:var(--green);color:#fff">Save Scores</button>
              </form>
            <% } %>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <!-- ── Host controls ─────────────────────────────────────────────────── -->
    <% if (canManage) { %>
      <details style="display:inline-block;margin-top:1rem;position:relative">
        <summary class="btn btn-sm btn-ghost" style="cursor:pointer;list-style:none;color:var(--text-muted)">⚙ Host controls</summary>
        <div style="position:absolute;top:calc(100% + .3rem);left:0;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:.6rem;display:flex;flex-direction:column;gap:.5rem;min-width:220px;z-index:10;box-shadow:0 4px 12px rgba(0,0,0,.08)">
          <% if (parThreeHoles.length > 0) { %>
            <div>
              <p class="label-small" style="margin-bottom:.3rem">Closest to the Pin holes</p>
              <form action="/game/<%= game.id %>/scorecard/ctp-holes" method="POST">
                <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.4rem">
                  <% parThreeHoles.forEach(h => { %>
                    <label style="display:flex;align-items:center;gap:.3rem;font-size:.78rem;cursor:pointer">
                      <input type="checkbox" name="ctp_holes" value="<%= h.hole_number %>" <%= h.is_ctp ? 'checked' : '' %> />
                      #<%= h.hole_number %>
                    </label>
                  <% }) %>
                </div>
                <button type="submit" class="btn btn-sm" style="width:100%">Save</button>
              </form>
            </div>
            <div class="admin-divider"></div>
          <% } %>
          <% if (!game.tournament_complete && isHost) { %>
            <form action="/game/<%= game.id %>/complete" method="POST"
                  onsubmit="return confirm('Mark this game complete? This locks in the winning team.')">
              <button type="submit" class="btn btn-sm" style="width:100%;background:var(--green);color:#fff">Mark complete</button>
            </form>
          <% } %>
          <% if (isHost) { %>
            <form action="/game/<%= game.id %>/delete" method="POST"
                  onsubmit="return confirm('Delete this game and all scores? Cannot be undone.')">
              <button type="submit" class="btn btn-sm btn-danger" style="width:100%">Delete game</button>
            </form>
          <% } %>
        </div>
      </details>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us – PickMates</title>
  <link rel="icon" href="/FavIcon.png" type="image/png" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="/" class="logo"><img src="/Logo.png" alt="PickMates" class="logo-img" /> PickMates</a>
      <nav><%- include('partials/nav') %></nav>
    </div>
  </header>

  <main>
    <div class="page-header">
      <h1>Contact Us</h1>
      <p class="last-updated">Questions, feedback, or something broken? Send us a message.</p>
    </div>

    <div class="auth-container">
      <div class="card auth-card" style="max-width:480px">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>
        <% if (success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>

        <% if (!success) { %>
          <form action="/contact" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="form-group">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" value="<%= name %>" required maxlength="100" autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="email">Your email</label>
              <input type="email" id="email" name="email" value="<%= email %>" required autocomplete="email" />
              <small>So we can reply to you.</small>
            </div>
            <div class="form-group">
              <label for="category">What's this about?</label>
              <select id="category" name="category"
                      style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;background:#fff;display:block;width:100%;margin-top:.3rem">
                <% CATEGORIES.forEach(c => { %>
                  <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c === 'Bug report' ? '🐛 Bug report' : c %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" required rows="6" maxlength="5000"
                        placeholder="If you're reporting a bug: what happened, what you expected instead, and which game/page it was on helps a lot."
                        style="padding:.45rem .75rem;border:1px solid var(--border);border-radius:var(--radius);font-size:.9rem;width:100%;font-family:inherit;resize:vertical"><%= message %></textarea>
            </div>
            <button type="submit" class="btn btn-block">Send message</button>
          </form>
        <% } else { %>
          <p class="auth-link"><a href="/">Back to games</a></p>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
